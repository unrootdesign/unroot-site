---
/* Шаблон страниц услуг: /web-design, /web-development, /logo-design, /services */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tri from './Tri.astro';
import { BUY_CONCEPT, CALL } from '../data/links';

type Item = string | { t: string; d?: string };
type Block =
  | { kind: 'steps'; items: { t: string; d?: string }[] }
  | { kind: 'list'; items: Item[] }
  | { kind: 'text'; paras: string[] }
  | { kind: 'pills'; items: string[]; note?: string }
  | { kind: 'compare'; cols: { t: string; items: string[] }[]; note?: string }
  | { kind: 'gallery'; images: { src: string; alt?: string }[] };
export interface Section { id?: string; tag: string; title: string; acc?: string; blocks: Block[]; image?: { src: string; alt?: string } }
export interface Props {
  title: string; description: string;
  tag: string; h1: string; acc?: string; lede: string;
  hero?: { src: string; alt?: string };
  sections: Section[];
  related?: 'web-design' | 'web-development' | 'logo-design';
}
const p = Astro.props;
const CAT: Record<string, string> = { 'web-design': 'Web design', 'web-development': 'Web development', 'logo-design': 'Logo design' };
const posts = p.related ? (await getCollection('blog', x => x.data.category === p.related && !x.data.noindex))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).slice(0, 3) : [];
const itemT = (i: Item) => typeof i === 'string' ? i : i.t;
const itemD = (i: Item) => typeof i === 'string' ? '' : (i.d ?? '');
---
<Base title={p.title} description={p.description}>
  <header class="phead">
    <div class="wrap">
      <p class="tag"><i></i>{p.tag}</p>
      <h1 class="h1 sv__h1">{p.h1}{p.acc && <> <span class="acc">{p.acc}</span></>}</h1>
      <p class="lede">{p.lede}</p>
      <div class="ctas">
        <a class="btn btn--main" href={BUY_CONCEPT}><span class="prints"></span><span>Get a concept, <span class="nw">$1,499</span></span><Tri /></a>
        <a class="btn btn--line" href={CALL}><span>Discuss a project</span><Tri /></a>
      </div>
      {p.hero && <img class="sv__hero" src={p.hero.src} alt={p.hero.alt ?? ''} loading="eager" decoding="async" />}
    </div>
  </header>

  {p.sections.map((s) => (
    <section class="sec" id={s.id}>
      <div class={`wrap sv__row${s.image ? ' sv__row--img' : ''}`}>
        <div class="sv__main">
          <p class="tag"><i></i>{s.tag}</p>
          <h2 class="h2">{s.title}{s.acc && <> <span class="acc">{s.acc}</span></>}</h2>
          {s.blocks.map((b) => (
            <div class="sv__block">
              {b.kind === 'steps' && (
                <ol class="sv__steps">{b.items.map((it, i) => (
                  <li><span class="mono sv__n">{String(i + 1).padStart(2, '0')}</span><b>{it.t}</b>{it.d && <p>{it.d}</p>}</li>
                ))}</ol>
              )}
              {b.kind === 'list' && (
                <ul class="sv__list">{b.items.map((it) => (
                  <li><b>{itemT(it)}</b>{itemD(it) && <span>{itemD(it)}</span>}</li>
                ))}</ul>
              )}
              {b.kind === 'text' && <div class="sv__text">{b.paras.map((t) => <p>{t}</p>)}</div>}
              {b.kind === 'pills' && (
                <div><ul class="sv__pills">{b.items.map((t) => <li class="mono">{t}</li>)}</ul>{b.note && <p class="sv__note">{b.note}</p>}</div>
              )}
              {b.kind === 'compare' && (
                <div>
                  <div class="sv__cmp">{b.cols.map((c) => (
                    <div><p class="mono sv__cmpk">{c.t}</p><ul class="sv__list">{c.items.map((t) => <li><b>{t}</b></li>)}</ul></div>
                  ))}</div>
                  {b.note && <p class="sv__note">{b.note}</p>}
                </div>
              )}
              {b.kind === 'gallery' && (
                <div class="sv__gal">{b.images.map((g) => <img src={g.src} alt={g.alt ?? ''} loading="lazy" decoding="async" />)}</div>
              )}
            </div>
          ))}
        </div>
        {s.image && <img class="sv__img" src={s.image.src} alt={s.image.alt ?? ''} loading="lazy" decoding="async" />}
      </div>
    </section>
  ))}

  {posts.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <p class="tag"><i></i>Also read</p>
        <h2 class="h2">From <span class="acc">the blog</span></h2>
        <ul class="cards sv__posts">
          {posts.map(x => (
            <li class="card"><a href={`/${x.data.category}/${x.data.slug}`}>
              {x.data.cover && <img class="card__img" src={x.data.cover} alt={x.data.coverAlt} loading="lazy" decoding="async" />}
              <p class="card__k mono">{CAT[x.data.category]}</p>
              <h3 class="card__t">{x.data.title}</h3>
              <span class="card__go link">Read <Tri /></span>
            </a></li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .sv__h1 { max-width: 20ch; }
  .sv__hero { width: 100%; margin-top: clamp(40px, 5vw, 64px); border: 1px solid var(--line); background: var(--bg); }
  .sv__row { display: grid; gap: clamp(28px, 5vw, 72px); }
  .sv__row--img { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); align-items: start; }
  @media (max-width: 960px) { .sv__row--img { grid-template-columns: 1fr; } }
  .sv__img { width: 100%; border: 1px solid var(--line); background: var(--bg); position: sticky; top: calc(var(--bar) + 32px); }
  @media (max-width: 960px) { .sv__img { position: static; } }
  .sv__block { margin-top: clamp(28px, 3.4vw, 44px); }
  .sv__steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0; padding: 1px 0 0 1px; }
  .sv__steps li { border: 1px solid var(--line); margin: -1px 0 0 -1px; padding: clamp(18px, 2vw, 24px); background: var(--white); }
  .sv__n { color: var(--violet-d); }
  .sv__steps b { display: block; margin-top: 16px; font-size: 1.1rem; font-weight: 500; letter-spacing: -.02em; line-height: 1.3; }
  .sv__steps p { margin-top: 8px; font-size: .92rem; line-height: 1.55; color: var(--ink-2); }
  .sv__list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .sv__list li { position: relative; padding: 14px 0 14px 22px; border-bottom: 1px solid var(--line); }
  .sv__list li::before { content: ""; position: absolute; left: 1px; top: 1.3em; width: 7px; height: 7px; background: var(--violet); clip-path: polygon(0 0, 100% 0, 100% 100%); }
  .sv__list b { font-weight: 500; font-size: 1.02rem; letter-spacing: -.01em; }
  .sv__list span { display: block; margin-top: 4px; color: var(--ink-2); font-size: .94rem; line-height: 1.5; }
  .sv__text { max-width: 62ch; }
  .sv__text p { color: var(--ink-2); font-size: 1.04rem; line-height: 1.7; }
  .sv__text p + p { margin-top: 1em; }
  .sv__pills { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .sv__pills li { padding: 9px 12px; background: var(--pale); color: var(--violet-d); border-radius: 3px; }
  .sv__note { margin-top: 18px; color: var(--ink-2); max-width: 62ch; }
  .sv__cmp { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3vw, 40px); }
  @media (max-width: 700px) { .sv__cmp { grid-template-columns: 1fr; } }
  .sv__cmpk { color: var(--violet-d); margin-bottom: 14px; }
  .sv__gal { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .sv__gal img { width: 100%; border: 1px solid var(--line); background: var(--bg); }
  .sv__posts { margin-top: clamp(32px, 4vw, 48px); }
</style>
