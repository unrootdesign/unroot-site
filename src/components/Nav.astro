---
/* Верхняя навигация с мега-меню. На компьютере панель открывается при наведении (и по клику),
   на телефоне бургер раскрывает список, группы открываются по нажатию. */
import Tri from './Tri.astro';
import { BUY_CONCEPT, CALL, SOCIAL } from '../data/links';
import { home } from '../data/home';
import logo from './logo.svg?raw';

interface Props { crumb?: string }
const { crumb } = Astro.props;
const logoSvg = logo.replace('<svg ', '<svg class="logo" aria-hidden="true" ');

// секции главной и шаблоны; созвон, вакансии и соцсети живут в Contact, блог отдельным пунктом
const page = [
  ['/#concept', 'Concept'], ['/#work', 'Work'], ['/#reviews', 'Reviews'], ['/#pricing', 'Pricing'],
  ['/#services', 'Services'], ['/#handover', 'After launch'], ['/#faq', 'FAQ'], ['/templates', 'Templates'],
];
const services = [
  ['/web-design', 'Website design'], ['/web-development', 'Webflow and Framer'],
  ['/logo-design', 'Logo and branding'], ['/services#3d', '3D and AI visuals'], ['/services', 'All services'],
];
const work = home.work.map(w => ({ href: `/case-studies/${w.cs}`, name: w.name, kind: w.kind, img: `/home/w-${w.slug}-1.jpg` }));
const chev = '<svg class="mm__chev" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.8 5 6.6l3-2.8" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>';
---
<header class="bar">
  <div class="wrap bar__in">
    <a href="/" class="bar__logo" aria-label="Unroot Design, home" set:html={logoSvg} />
    {crumb && <span class="bar__crumb" aria-hidden="true">/ <span id="xCrumb">{crumb}</span></span>}

    <nav class="bar__nav" id="barNav" aria-label="Main">
      <div class="mm">
        <button class="mm__t" type="button" aria-expanded="false">Home <Fragment set:html={chev} /></button>
        <div class="mm__p"><div class="wrap mm__in mm__in--home">
          <ul class="mm__l">{page.slice(0, 4).map(([h, l]) => <li><a href={h}>{l}</a></li>)}</ul>
          <ul class="mm__l">{page.slice(4).map(([h, l]) => <li><a href={h}>{l}</a></li>)}</ul>
          <a class="mm__card" href={BUY_CONCEPT}>
            <span class="mm__k">Start here</span>
            <b>Your new homepage in 7&nbsp;days</b>
            <span class="mm__cardp">$1,499 concept. Goes toward the full website if you start within 60 days.</span>
            <span class="mm__go">Get a concept <Tri /></span>
          </a>
        </div></div>
      </div>

      <div class="mm">
        <button class="mm__t" type="button" aria-expanded="false">Work <Fragment set:html={chev} /></button>
        <div class="mm__p"><div class="wrap mm__in mm__in--work">
          {work.map(w => (
            <a class="mm__w" href={w.href}>
              <img src={w.img} alt="" width="1600" height="900" loading="lazy" decoding="async" />
              <b>{w.name}</b><span>{w.kind}</span>
            </a>
          ))}
        </div></div>
      </div>

      <div class="mm">
        <button class="mm__t" type="button" aria-expanded="false">Services <Fragment set:html={chev} /></button>
        <div class="mm__p"><div class="wrap mm__in mm__in--svc">
          <ul class="mm__l">{services.slice(0, 3).map(([h, l]) => <li><a href={h}>{l}</a></li>)}</ul>
          <ul class="mm__l">{services.slice(3).map(([h, l]) => <li><a href={h}>{l}</a></li>)}</ul>
          <a class="mm__card" href={CALL}>
            <span class="mm__k">Not sure what you need?</span>
            <b>Tell us what you are building</b>
            <span class="mm__cardp">30 minutes with the people who do the work. No sales pitch.</span>
            <span class="mm__go">Book a call <Tri /></span>
          </a>
        </div></div>
      </div>

      <a class="mm__a" href="/blog">Blog</a>

      <div class="mm">
        <button class="mm__t" type="button" aria-expanded="false">Contact <Fragment set:html={chev} /></button>
        <div class="mm__p"><div class="wrap mm__in mm__in--hi">
          <ul class="mm__l"><li><a href={CALL}>Book a call</a></li><li><a href="/careers">Careers</a></li></ul>
          <ul class="mm__l">{SOCIAL.slice(0, 2).map(s => <li><a href={s.href} target="_blank" rel="noopener me">{s.label} ↗</a></li>)}</ul>
          <ul class="mm__l">{SOCIAL.slice(2).map(s => <li><a href={s.href} target="_blank" rel="noopener me">{s.label} ↗</a></li>)}</ul>
        </div></div>
      </div>
    </nav>

    <a class="bar__cta" href={BUY_CONCEPT}>Get a concept <Tri /></a>
    <button class="bar__burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="barNav"><i></i><i></i></button>
  </div>
</header>

<script>
  const bar = document.querySelector('.bar') as HTMLElement | null;
  const burger = bar?.querySelector('.bar__burger');
  const groups = [...(bar?.querySelectorAll('.mm') ?? [])] as HTMLElement[];
  const mobile = () => matchMedia('(max-width: 900px)').matches;
  const openGroup = (g: HTMLElement | null) => groups.forEach(x => {
    const on = x === g; x.classList.toggle('open', on);
    x.querySelector('.mm__t')?.setAttribute('aria-expanded', String(on));
  });
  const setMenu = (open: boolean) => {
    bar?.classList.toggle('is-open', open); burger?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
    if (!open) openGroup(null);
  };
  burger?.addEventListener('click', () => setMenu(!bar?.classList.contains('is-open')));
  // на компьютере панель открывается с маленькой задержкой и закрывается не сразу,
  // чтобы она не мигала, когда мышь идёт по диагонали к панели или ненадолго выходит за неё
  let tOpen = 0, tClose = 0, openedAt = 0;
  const cur = () => groups.find(x => x.classList.contains('open')) || null;
  groups.forEach(g => {
    g.querySelector('.mm__t')?.addEventListener('click', () => {
      if (!mobile() && cur() === g && performance.now() - openedAt < 600) return; // только что открыли наведением
      openGroup(cur() === g ? null : g); openedAt = performance.now();
    });
    g.addEventListener('pointerenter', e => {
      if (mobile() || (e as PointerEvent).pointerType !== 'mouse') return;
      clearTimeout(tClose); clearTimeout(tOpen);
      if (cur() === g) return;
      tOpen = window.setTimeout(() => { openGroup(g); openedAt = performance.now(); }, cur() ? 140 : 70);
    });
    g.addEventListener('pointerleave', e => {
      if (mobile() || (e as PointerEvent).pointerType !== 'mouse') return;
      clearTimeout(tOpen); clearTimeout(tClose);
      tClose = window.setTimeout(() => { if (cur() === g) openGroup(null); }, 260);
    });
  });
  bar?.querySelectorAll('.bar__nav a').forEach(a => a.addEventListener('click', () => { openGroup(null); setMenu(false); }));
  addEventListener('keydown', e => { if (e.key === 'Escape') { openGroup(null); setMenu(false); } });
  document.addEventListener('click', e => { if (!mobile() && !bar?.contains(e.target as Node)) openGroup(null); });
  addEventListener('resize', () => { if (!mobile()) setMenu(false); });
</script>

<style>
  .bar { position: sticky; top: 0; z-index: 50; height: var(--bar); background: var(--white); color: var(--ink); border-bottom: 1px solid var(--line); }
  .bar__in { height: 100%; display: flex; align-items: center; gap: 10px; }
  .bar__logo { color: var(--violet); display: block; }
  .bar__logo :global(.logo) { height: 17px; width: auto; display: block; }
  .bar__crumb { font-size: .95rem; line-height: 1; color: var(--ink-3); letter-spacing: -.01em; transform: translateY(1px); white-space: nowrap; }
  .bar__nav { margin-left: auto; display: flex; align-items: center; height: 100%; }
  .mm { height: 100%; display: flex; align-items: center; }
  .mm__t, .mm__a { display: inline-flex; align-items: center; gap: 5px; height: 36px; padding: 0 12px; border: 0; background: none; cursor: pointer;
    font: 500 .9rem/1 var(--f); letter-spacing: -.01em; color: var(--ink); transition: background var(--t) var(--ease), color var(--t) var(--ease); }
  .mm__t :global(.mm__chev) { width: 10px; height: 10px; color: var(--ink-3); transition: transform .2s var(--ease); }
  .mm__t:hover, .mm__a:hover, .mm.open .mm__t { color: var(--violet); }
  .mm.open .mm__t :global(.mm__chev) { transform: rotate(180deg); color: var(--violet); }
  .bar__cta { margin-left: 14px; display: inline-flex; align-items: center; gap: 10px; height: 36px; padding: 0 14px; background: var(--violet); color: #fff;
    font: 500 var(--caps-fs)/1 var(--f); letter-spacing: var(--caps-ls); text-transform: uppercase; transition: background var(--t) var(--ease); white-space: nowrap; }
  .bar__cta :global(.tri) { width: 7px; height: 7px; color: #fff; }
  .bar__cta:hover { background: var(--violet-hi); }

  /* панель мега-меню: во всю ширину под полосой, внутри общий контейнер */
  .mm__p { position: absolute; left: 0; right: 0; top: 100%; background: var(--white); border-bottom: 1px solid var(--line); box-shadow: 0 30px 60px -40px rgba(29,19,54,.35);
    visibility: hidden; opacity: 0; transform: translateY(-4px); transition: opacity .18s var(--ease), transform .18s var(--ease), visibility 0s linear .18s; }
  .mm:not(.open) .mm__p { pointer-events: none; }
  .mm.open .mm__p { visibility: visible; opacity: 1; transform: none; transition: opacity .18s var(--ease), transform .18s var(--ease); }
  .mm__in { display: grid; gap: 40px; padding-block: 32px 36px; }
  .mm__in--home { grid-template-columns: 1fr 1fr 1.2fr; }
  .mm__in--svc { grid-template-columns: 1fr 1fr 1.2fr; }
  .mm__in--hi { grid-template-columns: 1fr 1fr 1.2fr; align-items: start; }
  .mm__in--work { grid-template-columns: repeat(5, 1fr); gap: 16px; }
  .mm__k { font: 500 var(--caps-fs)/1 var(--mono); letter-spacing: var(--caps-ls); text-transform: uppercase; color: var(--ink-3); margin-bottom: 16px; }
  .mm__l { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .mm__l--2 { grid-template-columns: 1fr 1fr; column-gap: 24px; }
  .mm__l a { font-size: 1.05rem; letter-spacing: -.015em; color: var(--ink); transition: color var(--t) var(--ease); }
  .mm__l a:hover { color: var(--violet); }
  .mm__card { display: flex; flex-direction: column; gap: 10px; padding: 22px; background: var(--pale); color: var(--ink); transition: background var(--t) var(--ease); }
  .mm__card .mm__k { margin-bottom: 0; color: var(--violet-d); }
  .mm__card b { font-size: 1.35rem; font-weight: 500; letter-spacing: -.03em; line-height: 1.15; }
  .mm__cardp { font-size: .92rem; line-height: 1.45; color: var(--ink-2); }
  .mm__go { margin-top: auto; padding-top: 6px; display: inline-flex; align-items: center; gap: 8px; font-weight: 500; color: var(--violet); }
  .mm__go :global(.tri) { width: 7px; height: 7px; }
  .mm__card:hover { background: color-mix(in srgb, var(--pale) 70%, var(--violet) 12%); }
  .mm__w { display: flex; flex-direction: column; gap: 4px; color: var(--ink); }
  .mm__w img { width: 100%; height: auto; border: 1px solid var(--line); margin-bottom: 8px; transition: border-color var(--t) var(--ease); }
  .mm__w b { font-weight: 500; font-size: 1.05rem; letter-spacing: -.015em; }
  .mm__w span { font-size: .85rem; color: var(--ink-3); }
  .mm__w:hover b { color: var(--violet); }
  .mm__w:hover img { border-color: var(--violet); }

  /* бургер, только на телефоне и планшете */
  .bar__burger { display: none; }
  @media (max-width: 900px) {
    .bar__in { gap: 8px; }
    .bar__logo :global(.logo) { height: 15px; }
    .bar__cta { margin-left: auto; height: 34px; padding: 0 11px; }
    .bar__burger { display: grid; place-content: center; gap: 6px; width: 40px; height: 40px; margin-right: -10px; background: none; border: 0; cursor: pointer; color: var(--ink); }
    .bar__burger i { display: block; width: 18px; height: 1.5px; background: currentColor; transition: transform var(--t) var(--ease); }
    .bar.is-open .bar__burger i:first-child { transform: translateY(3.75px) rotate(45deg); }
    .bar.is-open .bar__burger i:last-child { transform: translateY(-3.75px) rotate(-45deg); }
    .bar__nav { position: fixed; left: 0; right: 0; top: var(--bar); bottom: 0; margin: 0; height: auto; display: block; overflow-y: auto; background: var(--white);
      padding: 8px var(--gut) 40px; visibility: hidden; opacity: 0; transition: opacity .2s var(--ease), visibility 0s linear .2s; }
    .bar.is-open .bar__nav { visibility: visible; opacity: 1; transition: opacity .2s var(--ease); }
    .mm { height: auto; display: block; border-bottom: 1px solid var(--line); }
    .mm__t, .mm__a { width: 100%; height: 60px; padding: 0; justify-content: space-between; font-size: 1.3rem; letter-spacing: -.02em; border-radius: 0; }
    .mm__a { border-bottom: 1px solid var(--line); }
    .mm__t :global(.mm__chev) { width: 14px; height: 14px; }
    .mm__p { position: static; display: none; visibility: visible; opacity: 1; transform: none; border: 0; box-shadow: none; transition: none; }
    .mm.open .mm__p { display: block; }
    .mm__in, .mm__in--home, .mm__in--svc, .mm__in--hi { grid-template-columns: 1fr; gap: 24px; padding: 4px 0 24px; }
    .mm__in--work { grid-template-columns: 1fr 1fr; gap: 16px 12px; }
  }
</style>
