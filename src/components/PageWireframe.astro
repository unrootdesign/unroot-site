---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import type { PageBlueprint } from '../data/pages';
interface Props { page: PageBlueprint }
const { page } = Astro.props;
---
<BaseLayout title={page.title} description={page.description}>
  <Header />
  <main>
    <section class="hero">
      <div class="container">
        <p class="eyebrow">{page.eyebrow} · wireframe</p>
        <h1>{page.h1}</h1>
        <p class="intro">{page.intro}</p>
        <div class="meta-row">
          <span class="pill">URL: /{page.slug}</span>
          <span class="pill">Source: {page.source}</span>
          <span class="pill">SEO metadata retained</span>
        </div>
      </div>
    </section>
    <section class="sections">
      <div class="container">
        {page.sections.map((section, index) => (
          <article class="section-card">
            <div class="section-index">{String(index + 1).padStart(2, '0')}</div>
            <div>
              <h2>{section}</h2>
              <div class="placeholder">Content/media slot — migrate current content here or replace during redesign.</div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <footer><div class="container">Unroot migration wireframe · structure-first build</div></footer>
</BaseLayout>
