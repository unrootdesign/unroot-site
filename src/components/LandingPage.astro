---
/* Шаблон отдельных страниц под поисковые запросы: /pricing, /web-design/ai-startups, /concept.
   Текст от Adam (документ «Batch 1: page copy and build notes»), ничего сверх него.
   Слева заголовок секции, справа содержимое. Вопросы и ответы видны в HTML и дублируются в схеме FAQPage. */
import Base from '../layouts/Base.astro';
import Tri from './Tri.astro';
import { BUY_CONCEPT, CALL } from '../data/links';

const M = '/home/';
type Block =
  | { kind: 'text'; html: string[] }                                  // абзацы, внутри можно <a>
  | { kind: 'plans'; items: { name: string; price: string; d: string; btn: 'concept' | 'call'; more?: { label: string; href: string } }[] }
  | { kind: 'bullets'; items: string[] }
  | { kind: 'steps'; items: { t?: string; d: string }[] }
  | { kind: 'quote'; text: string; name: string; role: string; avatar?: string }
  | { kind: 'pairs'; items: { slug: string; name: string }[] }
  | { kind: 'links'; items: { label: string; href: string }[] };
export interface Props {
  title: string; description: string;
  tag: string; h1: string; lede: string;
  crumbs: { name: string; href?: string }[];
  sections: { h: string; blocks: Block[] }[];
  faqTitle: string;
  faq: { q: string; a: string }[];
  closing: string;
  extraSchema?: unknown[];
}
const p = Astro.props;
const site = 'https://unroot.design';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const schema = [
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: p.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: p.crumbs.map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.name, item: site + (c.href ?? path) })) },
  ...(p.extraSchema ?? []),
];
const Btn = { concept: { href: BUY_CONCEPT, label: 'Get a concept', main: true }, call: { href: CALL, label: 'Discuss a project', main: false } };
---
<Base title={p.title} description={p.description} schema={schema}>
  <header class="phead">
    <div class="wrap">
      <nav class="crumbs mono" aria-label="Breadcrumb">
        {p.crumbs.map((c, i) => i < p.crumbs.length - 1
          ? <><a href={c.href}>{c.name}</a><span aria-hidden="true">/</span></>
          : <span>{c.name}</span>)}
      </nav>
      <h1 class="h1 lp__h1">{p.h1}</h1>
      <p class="lede lp__lede">{p.lede}</p>
      <div class="ctas">
        <a class="btn btn--main" href={BUY_CONCEPT}><span>Get a concept, <span class="nw">$1,499</span></span><Tri /></a>
        <a class="btn btn--line" href={CALL}><span>Discuss a project</span><Tri /></a>
      </div>
    </div>
  </header>

  {p.sections.map((s) => (
    <section class="sec">
      <div class="wrap lp__row">
        <h2 class="h2 lp__h2">{s.h}</h2>
        <div class="lp__body">
          {s.blocks.map((b) => (
            <>
              {b.kind === 'text' && <div class="lp__text">{b.html.map((t) => <p set:html={t} />)}</div>}
              {b.kind === 'plans' && (
                <div class="lp__plans">{b.items.map((it) => (
                  <article class={`lp__plan${it.btn === 'concept' ? ' lp__plan--concept' : ''}`}>
                    <p class="mono lp__pn">{it.name}</p>
                    <p class="lp__pp">{it.price}</p>
                    <p class="lp__pd">{it.d}</p>
                    <div class="lp__pa">
                      <a class={`btn ${Btn[it.btn].main ? 'btn--main' : 'btn--line'}`} href={Btn[it.btn].href}><span>{Btn[it.btn].label}</span><Tri /></a>
                      {it.more && <a class="link lp__more" href={it.more.href}>{it.more.label} <Tri /></a>}
                    </div>
                  </article>
                ))}</div>
              )}
              {b.kind === 'bullets' && <ul class="lp__list">{b.items.map((t) => <li set:html={t} />)}</ul>}
              {b.kind === 'steps' && (
                <ol class="lp__steps">{b.items.map((it, i) => (
                  <li><span class="mono lp__n">{String(i + 1).padStart(2, '0')}</span><p>{it.t && <b>{it.t} </b>}<span set:html={it.d} /></p></li>
                ))}</ol>
              )}
              {b.kind === 'quote' && (
                <blockquote class="quote lp__quote">
                  <p>{b.text}</p>
                  <footer>
                    {b.avatar && <img src={`${M}av-${b.avatar}.jpg`} alt="" width="46" height="46" loading="lazy" />}
                    <span><b>{b.name}</b><s>{b.role}</s></span>
                  </footer>
                </blockquote>
              )}
              {b.kind === 'pairs' && (
                <ul class="lp__pairs">{b.items.map((x) => (
                  <li>
                    <p class="lp__pairn">{x.name}</p>
                    <div class="lp__pair">
                      <figure><figcaption class="mono">Before</figcaption><img src={`${M}p-${x.slug}-before.jpg`} alt={`${x.name} homepage before`} width="620" height="1033" loading="lazy" decoding="async" /></figure>
                      <figure><figcaption class="mono lp__after">After, 7 days later</figcaption><img src={`${M}p-${x.slug}-after.jpg`} alt={`${x.name} homepage after`} width="620" height="1033" loading="lazy" decoding="async" /></figure>
                    </div>
                  </li>
                ))}</ul>
              )}
              {b.kind === 'links' && (
                <ul class="lp__links">{b.items.map((l) => <li><a class="link" href={l.href}>{l.label} <Tri /></a></li>)}</ul>
              )}
            </>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="sec" id="faq">
    <div class="wrap lp__row">
      <h2 class="h2 lp__h2">{p.faqTitle}</h2>
      <div class="lp__body lp__faq">
        {p.faq.map((f) => <div class="lp__q"><h3>{f.q}</h3><p>{f.a}</p></div>)}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap lp__row">
      <p class="h2 lp__h2 lp__close">{p.closing}</p>
      <div class="lp__body">
        <div class="ctas lp__closeb">
          <a class="btn btn--main" href={BUY_CONCEPT}><span>Get a concept, <span class="nw">$1,499</span></span><Tri /></a>
          <a class="btn btn--line" href={CALL}><span>Discuss a project</span><Tri /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .lp__h1 { max-width: 16ch; }
  .lp__lede { max-width: 60ch; }
  .lp__row { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.4fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  @media (max-width: 900px) { .lp__row { grid-template-columns: 1fr; } }
  .lp__h2 { position: sticky; top: calc(var(--bar) + 32px); }
  @media (max-width: 900px) { .lp__h2 { position: static; } }
  .lp__body > * + * { margin-top: clamp(24px, 3vw, 36px); }
  .lp__text { max-width: 62ch; }
  .lp__text p { color: var(--ink-2); font-size: 1.06rem; line-height: 1.7; }
  .lp__text p + p { margin-top: 1em; }
  .lp__text a, .lp__list a, .lp__steps a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--violet); text-underline-offset: 4px; transition: color var(--t) var(--ease); }
  .lp__text a:hover, .lp__list a:hover, .lp__steps a:hover { color: var(--violet-d); }
  .lp__text b { color: var(--ink); font-weight: 500; }

  /* цены: карточки как на главной, концепт тёмный */
  .lp__plans { display: grid; gap: 16px; }
  .lp__plan { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 24px; padding: clamp(22px, 2.6vw, 30px); background: var(--white); border: 1px solid var(--line); }
  .lp__pn { grid-column: 1 / -1; color: var(--ink-3); }
  .lp__pp { font-size: clamp(2.2rem, 3.4vw, 2.8rem); font-weight: 500; letter-spacing: -.05em; line-height: 1; }
  .lp__pd { grid-column: 1 / -1; margin-top: 8px; color: var(--ink-2); line-height: 1.6; max-width: 58ch; }
  .lp__pa { grid-column: 1 / -1; margin-top: 14px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
  .lp__plan--concept { background: var(--night); border-color: var(--night); color: #fff; }
  .lp__plan--concept .lp__pn { color: var(--violet-lt); }
  .lp__plan--concept .lp__pd { color: color-mix(in srgb, #fff 75%, transparent); }
  .lp__plan--concept .lp__more { color: #fff; }

  .lp__list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .lp__list li { position: relative; padding: 14px 0 14px 22px; border-bottom: 1px solid var(--line); line-height: 1.55; }
  .lp__list li::before { content: ""; position: absolute; left: 1px; top: 1.4em; width: 7px; height: 7px; background: var(--violet); clip-path: polygon(0 0, 100% 0, 100% 100%); }
  .lp__steps { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .lp__steps li { display: grid; grid-template-columns: 2.6rem 1fr; gap: 12px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .lp__steps p { line-height: 1.6; color: var(--ink-2); }
  .lp__steps b { color: var(--ink); font-weight: 500; }
  .lp__n { color: var(--violet-d); padding-top: 4px; }
  .lp__quote s { display: block; text-decoration: none; color: var(--ink-3); font-size: .9rem; }

  /* до и после: 7 пар с главной */
  .lp__pairs { list-style: none; padding: 0; margin: 0; display: grid; gap: clamp(32px, 4vw, 48px); }
  .lp__pairn { font-size: 1.15rem; font-weight: 500; letter-spacing: -.02em; margin-bottom: 12px; }
  .lp__pair { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(10px, 1.6vw, 18px); }
  .lp__pair figure { margin: 0; }
  .lp__pair figcaption { margin-bottom: 8px; color: var(--ink-3); }
  .lp__pair .lp__after { color: var(--violet-d); }
  .lp__pair img { display: block; width: 100%; height: auto; background: var(--white); border: 1px solid var(--line); }
  .lp__pair figure:last-child img { border-color: var(--violet); }

  .lp__links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 14px 28px; }
  .lp__faq { border-top: 1px solid var(--line); }
  .lp__q { padding: 22px 0; border-bottom: 1px solid var(--line); }
  .lp__q h3 { font-size: 1.15rem; font-weight: 500; letter-spacing: -.02em; line-height: 1.3; }
  .lp__q p { margin-top: 10px; color: var(--ink-2); line-height: 1.6; max-width: 62ch; }
  .lp__close { max-width: 18ch; }
  .lp__closeb { margin-top: 0; }
</style>
