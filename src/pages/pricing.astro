---
import LandingPage from '../components/LandingPage.astro';
import { BUY_CONCEPT } from '../data/links';
// Ноябрь 2026: публичная цена осталась только у концепта. Полный сайт оцениваем после созвона.
// Тексты собраны из Batch 1 (Adam), без цен спринта и месяца
const title = "Website design pricing for startups | Unroot Design";
const description = "The homepage concept is $1,499 in 7 days. The full website is priced after a call, once we know what you need.";
const org = { '@type': 'Organization', name: 'Unroot Design', url: 'https://unroot.design' };
---
<LandingPage title={title} description={description}
  crumbs={[{ name: 'Home', href: '/' }, { name: 'Pricing' }]}
  h1="Website design pricing <span>for startups</span>"
  lede="2 ways to start. Take the $1,499 homepage concept, or tell us about the full project on a call and we send you an estimate."
  sections={[
    { h: '2 ways <span>to start</span>', blocks: [{ kind: 'plans', cols: 2, items: [
      { name: 'Not sure where to start?', price: '$1,499', unit: 'homepage concept, 7 days', btn: 'concept', more: { label: 'How the concept works', href: '/concept' },
        d: 'An animated homepage concept, hero plus 3 sections. Designed in Figma and turned into a live preview you can click through and share with your team. The files are yours. The $1,499 goes toward the full website if you start within 60 days.' },
      { name: 'Know what you need?', price: 'Let’s talk', unit: 'full website, priced after a call', btn: 'call',
        d: 'The price depends on what you need. Tell us about the project in a 30 minute call, and we send you an estimate. You can also start with the concept and price the rest after it.' },
    ]}]},
    { h: 'What every project <span>includes</span>', blocks: [{ kind: 'tiles', items: [
      'A private Slack channel with the people doing the work.',
      'Weekly updates and a status message every Friday, good news or not.',
      'All files are yours once the project is paid: Figma, the Webflow or Framer project, code and assets.',
      'A handover call. After it your team changes copy, pages and posts by asking AI in plain words.',
    ]}]},
    { h: 'What is <span>not included</span>', blocks: [{ kind: 'text', big: true, html: [
      'Revisions in the concept. The concept is 1 direction, done once. Revisions happen in the full project, which is priced separately.',
    ]}]},
    { h: 'Who is <span>behind it</span>', blocks: [
      { kind: 'text', html: ['A team of 5 in Warsaw, with no account managers in between. 9 years, 100+ brands, $130M+ raised by clients.'] },
      { kind: 'quote', text: '“We could not have been happier with his work and strongly recommend him to any future clients.”', name: 'Tasnia Huque', role: 'Principal at Javelin VP', avatar: 'tasnia' },
      { kind: 'links', items: [{ label: 'Website design for AI startups', href: '/web-design/ai-startups' }, { label: 'Book a call', href: '/call' }] },
    ]},
  ]}
  faqTitle="Pricing <span>questions</span>"
  faq={[
    { q: 'How much does a startup website cost with Unroot?', a: 'It depends on what you need. Tell us about the project on a call, and we send you an estimate. If you want to see the direction first, start with the $1,499 concept.' },
    { q: 'How long does a website take?', a: 'The concept takes 7 days. A landing page plus a few pages fits into 1 month. A full website takes 1–2 months.' },
    { q: 'What if I do not move forward after the concept?', a: 'You keep the concept and can build it with anyone. If you start the full website with us within 60 days, the $1,499 goes toward it.' },
    { q: 'Who owns the files?', a: 'You do. Everything is yours once the project is paid.' },
  ]}
  closing="Take the concept, or want a call first?"
  extraSchema={[{
    '@context': 'https://schema.org', '@type': 'Offer', name: 'Homepage concept', price: '1499', priceCurrency: 'USD', url: BUY_CONCEPT, seller: org,
  }]}
/>
