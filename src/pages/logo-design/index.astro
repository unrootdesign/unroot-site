---
import ServicePage from '../../components/ServicePage.astro';
// title и description дословно из Webflow
const title = "Standout Logo Design Services for Modern Brands | Unroot.design";
const description = "Get a memorable, versatile logo crafted for your brand by Unroot.design. Our step-by-step process delivers custom, scalable logos for AI startups, tech companies and Saas.";
const I = '/images/';
---
<ServicePage title={title} description={description} related="logo-design"
  tag="Logo design"
  h1="Logo design" acc="for startups and tech brands"
  lede="A logo and visual identity made for your company, from the brief and research to final vector files. It works on your website, product, packaging and social media."
  hero={{ src: I + '1.avif', alt: 'Logo design process' }}
  sections={[
    { tag: 'Process', title: 'How we design a logo,', acc: 'step by step', blocks: [
      { kind: 'steps', items: [
        { t: 'Discovery and your project brief' }, { t: 'Market research, moodboarding and design direction' },
        { t: 'Sketches and concept exploration' }, { t: 'Digital drafts in Figma or Illustrator' },
        { t: 'Getting feedback' }, { t: 'Logo refinement' }, { t: 'Final exports (SVG, PNG, EPS)' },
      ]},
      { kind: 'pills', items: ['Branding guidelines', 'Animated logos', '3D logo'], note: 'Add-on services you can add to any logo project.' },
    ]},
    { tag: 'What you get', title: 'What You Will Get', acc: 'from Us', image: { src: I + 'clothing-brand-logo-multiplatform-mockup_1.avif', alt: 'Clothing brand logo shown on website, apparel, packaging, and Instagram ads to demonstrate versatile branding.' }, blocks: [{ kind: 'list', items: [
      { t: 'Brand-Aligned', d: 'Built around your mission and values' },
      { t: 'Versatile', d: 'Works across websites, packaging, social media' },
      { t: 'Memorable', d: 'Simple shapes people recognize at a glance' },
      { t: 'Scalable', d: 'Vector files that stay sharp at any size' },
      { t: 'Images, mockups' },
    ]}]},
    { tag: 'Why Unroot', title: 'Why Clients Work', acc: 'with Unroot', image: { src: I + 'rough-logo-sketches-brainstorming_1.avif', alt: 'A notebook with rough sketches of logo concepts, showcasing the brainstorming phase of logo creation' }, blocks: [{ kind: 'list', items: [
      'We adapt the timeline to your project', 'Changes until the logo is right',
      'A shared Slack channel with the designers doing the work', 'Weekly calls if you need them',
    ]}]},
    { tag: 'Work', title: 'Logos and brands', acc: 'we designed', blocks: [{ kind: 'gallery', images: [
      { src: I + '2.avif', alt: 'Brand identity board for ambient, showing logo, product mockups, color palette, UI icons, employee badges, and Overused Grotesk typeface.' },
      { src: I + '3.avif', alt: 'Side-by-side mockups of Ambient Twitter profile in light and dark mode, featuring the Dreamie sleep device banner' },
      { src: I + 'logo-brand1_1.avif', alt: 'Logo and brand work' },
    ]}]},
    { tag: 'Niches', title: 'Niches', acc: 'We Work With', blocks: [{ kind: 'pills', items: ['AI startups', 'Tech companies', 'SaaS'], note: 'Not on the list? Ask anyway.' }]},
  ]} />
