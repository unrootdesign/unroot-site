---
import ServicePage from '../../components/ServicePage.astro';
// title и description дословно из Webflow
const title = "We Design Websites That Inspire, Engage, and Drive Real Results | Unroot.design";
const description = "Discover how Unroot designs websites that convert: from custom layouts and user-centered design to responsive development and ongoing support.";
const I = '/images/';
---
<ServicePage title={title} description={description} related="web-design"
  tag="Website design"
  h1="We Design Websites That Inspire, Engage," acc="and Drive Real Results"
  lede="Websites for startups and tech companies, from strategy and wireframes to final layouts and a build in Webflow or Framer. Visitors understand your product on the first screen and know what to do next."
  hero={{ src: I + 'Infographic-Mockup-Website-Design.avif', alt: 'Website design mockups' }}
  sections={[
    { tag: 'Process', title: 'How We Build Websites', acc: 'That Work for Your Business', blocks: [{ kind: 'steps', items: [
      { t: 'Planning', d: 'We define your goals, audience and website structure, then make a sitemap and wireframes before any visual design.' },
      { t: 'Design', d: 'Layouts in your brand, built around what visitors need to understand and do. Every page is designed for mobile and desktop.' },
      { t: 'Development', d: 'We build in Webflow or Framer with a clean structure and SEO basics, and check it across devices and browsers.' },
      { t: 'Support', d: 'After launch we stay on for updates, fixes and new pages.' },
    ]}]},
    { tag: 'What you get', title: 'What You Will Get', acc: 'from Us', image: { src: I + 'Infographic-Mockup-Features.avif' }, blocks: [{ kind: 'list', items: [
      { t: 'Custom Design', d: 'Made for your brand and goals, no templates' },
      { t: 'Responsive', d: 'Designed for mobile, tablet and desktop' },
      { t: 'User-Centered', d: 'Structured around what visitors need to decide' },
      { t: 'SEO-Ready', d: 'Clean headings, meta fields and fast pages' },
      { t: 'Scalable', d: 'New pages and sections without a redesign' },
      { t: 'Visual Assets', d: 'Mockups, illustrations and animations when the project needs them' },
    ]}]},
    { tag: 'Why Unroot', title: 'Why Clients Work', acc: 'with Unroot', image: { src: I + 'Infographic-Our-Principles.avif' }, blocks: [{ kind: 'list', items: [
      'We adapt deadlines to your project',
      'Iterations until it is right',
      'Direct contact with the designer in a shared Slack',
      'Weekly updates and calls',
    ]}]},
    { tag: 'Work', title: 'Websites', acc: 'We Have Designed', blocks: [{ kind: 'gallery', images: [
      { src: I + 'Ambient-Dreamie-Hero-Section.avif', alt: 'Ambient Dreamie website' },
      { src: I + 'Epsilon-Health-Hero-Section.avif', alt: 'Epsilon Health website' },
      { src: I + 'CF-1-Hero-Section.avif', alt: 'Website hero section' },
    ]}]},
    { tag: 'Niches', title: 'Niches', acc: 'We Work With', blocks: [{ kind: 'pills',
      items: ['AI startups', 'Tech companies', 'SaaS', 'Creative businesses', 'Professional services'],
      note: 'Not on the list? Ask anyway.' }]},
  ]} />
