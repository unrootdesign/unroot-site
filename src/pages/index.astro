---
/* Экспериментальная главная (ветка next): одна страница с прокруткой, сверху общая навигация с мега-меню.
   Герой: текст слева, концепты справа сменяются сами, под ними названия проектов. Дальше бегущая лента работ,
   отзывы, цены, услуги, после запуска, созвон, FAQ и обычный футер. Все секции в одном контейнере --wrap. */
import Base from '../layouts/Base.astro';
import Tri from '../components/Tri.astro';
import { home } from '../data/home';
import { BUY_CONCEPT, CALL } from '../data/links';
import '../styles/x.css';
import '../styles/chat.css';

// title и description дословно из Webflow
const title = "Design partner for AI and Tech founders | Unroot Design";
const description = "We design and build premium, custom websites with 3D & motion. We clarify complex products, ship in Webflow, and lift conversions with fast weekly sprints.";

const M = '/home/';
const pad = (n: number) => String(n).padStart(2, '0');
// короткие названия проектов под концептом в герое
const short = (n: string) => ({ 'Ambient Dreamie': 'Dreamie', 'Burd Home Health': 'Burd', 'Epsilon Health': 'Epsilon', 'Javelin VP': 'Javelin' } as Record<string, string>)[n] ?? n;
// значки шагов процесса: перо (дизайн), курсор (прототип), код (сборка), люди (передача команде)
const NI = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const NODE = [
  NI('<path d="M12 3l6 6-7 11-4-4z"/><path d="M7 16l-3 5 5-3"/><circle cx="13" cy="9" r="1.5"/>'),
  NI('<path d="M5 3l12 6-5 2-2 5z"/><path d="M13 13l5 5"/>'),
  NI('<path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>'),
  NI('<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 5.5a3 3 0 010 5.5M18 14.5c1.8.8 3 2.6 3 4.5"/>'),
];
const schema = [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: home.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
---
<Base title={title} description={description} schema={schema} bodyClass="x">
  <!-- 1. Герой: слева текст и кнопки, справа концепты (табы: анимированные или до и после) -->
  <section class="xs xhero" id="concept" data-mode="anim" aria-label="Concept">
    <div class="xw x3 xhero__in">
      <div class="xhero__txt">
        <p class="tag xtag"><i></i>Design for AI and tech startups</p>
        <h1 class="xhero__h">Your new homepage <span>in 7&nbsp;days</span></h1>
        <p class="xhero__s">Click through your new homepage first. Then we build the full website, and your team runs it with&nbsp;AI.</p>
        <div class="xhero__ctas">
          <a class="btn btn--main" href={BUY_CONCEPT}><span>Get a concept, $1,499</span><Tri /></a>
          <a class="btn btn--line" href={CALL}><span>Discuss a project</span><Tri /></a>
        </div>
      </div>

      <div class="xhero__vis s2">
        <!-- табы прямо над концептом, справа: анимированные концепты или до и после; проекты сменяются сами -->
        <div class="xc__mode" role="tablist" aria-label="Show">
          <button type="button" role="tab" data-mode="anim" aria-selected="true">Animated</button>
          <button type="button" role="tab" data-mode="ba" aria-selected="false">Before / after</button>
        </div>
        <div class="xhero__stage">
          <div class="xc__stage xc__stage--anim">
            {home.pairs.map((p, i) => (
              <div class={`xc__vid${i === 0 ? ' on' : ''}`} data-i={i}>
                <div class="xc__frame"><video src={`${M}v-${p.slug}.mp4`} poster={`${M}v-${p.slug}.jpg`} muted playsinline preload={i === 0 ? 'auto' : 'none'}></video></div>
              </div>
            ))}
          </div>
          <div class="xc__stage xc__stage--ba">
            {home.ba.map((p, i) => (
              <div class={`xc__pair${i === 0 ? ' on' : ''}`} data-i={i}>
                <figure><figcaption>Before</figcaption><img src={`${M}p-${p.slug}-before.jpg`} alt={`${p.name} before`} width="620" height="1033" loading="lazy" /></figure>
                <span class="xc__arrow" aria-hidden="true">→</span>
                <figure><figcaption class="after">After, 7 days later</figcaption><img src={`${M}p-${p.slug}-after.jpg`} alt={`${p.name} after`} width="620" height="1033" loading="lazy" /></figure>
              </div>
            ))}
          </div>
          <div class="xhero__names">
            <ol class="xc__names">{home.pairs.map((p, i) => <li><button type="button" class={i === 0 ? 'on' : ''} data-i={i}>{short(p.name)}</button></li>)}</ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Работы: бегущая лента справа налево, при наведении стоит; на фоне крупная серая подпись -->
  <section class="xs xwork" id="work" aria-label="Case studies">
    <p class="xwork__bg" aria-hidden="true">case studies</p>
    <!-- рукописная подсказка: ленту можно тянуть -->
    <div class="xwork__hint" aria-hidden="true">
      <span>drag me</span>
      <svg viewBox="0 0 150 120" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 34C14 14 118 2 136 24c14 18-50 34-104 28C10 50 4 36 20 22c10-8 30-12 46-13"/>
        <path d="M58 58c-6 22-22 40-46 52"/><path d="M12 110l14-1M12 110l3-13"/>
      </svg>
    </div>
    <div class="xmq" id="xRow">
      <div class="xmq__t">
        {[0, 1].map(copy => home.work.map(w => {
          const href = w.cs ? `/case-studies/${w.cs}` : w.url;
          const hide = copy === 1;
          return (
            <article class="xg" aria-hidden={hide ? 'true' : undefined}>
              <a class="xg__head" href={href} tabindex={hide ? -1 : undefined}><b>{w.name}</b> {w.kind} · {w.scope}</a>
              <a class="xg__main" href={href} aria-label={`${w.name}, case study`} tabindex={hide ? -1 : undefined}>
                {[1, 2, 3, 4].map(k => <img src={`${M}w-${w.slug}-${k}.jpg`} alt={k === 1 && !hide ? w.name : ''} class={k === 1 ? 'on' : ''} data-k={k} width="1600" height="900" loading="lazy" decoding="async" draggable="false" />)}
              </a>
              <div class="xg__thumbs">
                {[2, 3, 4].map(k => <button type="button" data-k={k} tabindex={hide ? -1 : undefined} aria-label={`${w.name}, image ${k}`}><img src={`${M}w-${w.slug}-${k}.jpg`} alt="" width="1600" height="900" loading="lazy" decoding="async" draggable="false" /></button>)}
              </div>
              <div class="xg__foot">
                <p class="xg__stat"><b>{w.stat}</b> {w.statLabel}</p>
                <a class="xg__go" href={href} tabindex={hide ? -1 : undefined}>View case study <Tri /></a>
              </div>
            </article>
          );
        }))}
      </div>
    </div>
  </section>

  <!-- 3. Отзывы: слева отзыв в узкой колонке, справа логотипы клиентов -->
  <section class="xs" id="reviews" aria-label="Reviews">
    <div class="xw">
      <p class="tag xtag"><i></i>Testimonials</p>
      <h2 class="xh2">What clients say <span>after</span></h2>
      <div class="x3 xr">
        <div class="xq s2" id="xq">
          {home.quotes.map((q, i) => (
            <blockquote class={i === 0 ? 'on' : ''}>
              <p>&ldquo;{q.text}&rdquo;</p>
              <footer>
                <img src={`${M}av-${q.avatar}.jpg`} alt="" width="44" height="44" loading="lazy" />
                <span><b>{q.name}</b>{q.role}</span>
              </footer>
              {q.url && <a class="xq__tp" href={q.url} target="_blank" rel="noopener">See on Trustpilot ↗</a>}
            </blockquote>
          ))}
          <div class="xq__nav">
            <button type="button" class="xq__arr" data-d="-1" aria-label="Previous review">←</button>
            <button type="button" class="xq__arr" data-d="1" aria-label="Next review">→</button>
          </div>
        </div>
        <div class="xr__logos">
          <ul>{home.logos.map(l => <li><img src={`${M}logos/${l.slug}.png`} alt={l.name} style={`height:${l.h}px`} loading="lazy" /></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Цены: 2 формата работы и концепт для тех, кто не знает, с чего начать -->
  <section class="xs" id="pricing" aria-label="Pricing">
    <div class="xw">
      <p class="tag xtag"><i></i>Pricing</p>
      <h2 class="xh2">Pick how we <span>work together</span></h2>
      <div class="x3 xp">
        <article class="xp__c">
          <p class="xp__n">Design and Build Sprint</p>
          <p class="xp__p">$2,499<small>/ week</small></p>
          <p class="xp__d">1 week of design, build or both. Ends on Friday, no notice period.</p>
          <a class="btn btn--line xp__btn" href={CALL}><span>Discuss a project</span><Tri /></a>
        </article>
        <article class="xp__c">
          <p class="xp__n">Monthly Design and Build</p>
          <p class="xp__p">$7,899<small>/ month</small></p>
          <p class="xp__d">4 weeks with a senior designer and a senior developer. Handover and AI setup included. Pause or stop after any month.</p>
          <a class="btn btn--line xp__btn" href={CALL}><span>Discuss a project</span><Tri /></a>
        </article>
        <article class="xp__c xp__c--concept">
          <canvas class="stars" data-d=".3" aria-hidden="true"></canvas>
          <p class="xp__n">Not sure where to start?</p>
          <p class="xp__p">$1,499<small>homepage concept, 7 days</small></p>
          <ul class="xp__list">
            <li>3–4 homepage sections with our direction for your product</li>
            <li>A live preview you can click through and share with your team</li>
            <li>The files are yours to keep and build on</li>
            <li>The $1,499 goes toward the full website if you start within 60 days</li>
          </ul>
          <a class="btn btn--main xp__btn" href={BUY_CONCEPT}><span>Get a concept, $1,499</span><Tri /></a>
        </article>
      </div>
    </div>
  </section>

  <!-- 5. Услуги: слева тег, заголовок и список до низа кадра; справа кадр вровень с заголовком, в своей пропорции -->
  <section class="xs" id="services" aria-label="Services">
    <div class="xw">
      <div class="x3 xsv">
        <div class="xsv__l">
          <p class="tag xtag"><i></i>Services</p>
          <h2 class="xh2">What we <span>do</span></h2>
          <ol class="xsv__list">
            {home.services.map((s, i) => <li><button type="button" class={i === 0 ? 'on' : ''} data-i={i}><span>{pad(i + 1)}</span>{s.name}</button></li>)}
          </ol>
        </div>
        <div class="xsv__media s2">
          {home.services.map((s, i) => (
            <figure class={`xsv__m${i === 0 ? ' on' : ''}`} data-i={i}>
              <div class="xsv__v" style={`aspect-ratio:${s.ratio}`}>
                {s.video
                  ? <video src={`${M}${s.video}.mp4`} poster={`${M}${s.video}.jpg`} muted loop playsinline preload="none"></video>
                  : s.images.map((x, k) => <img src={`${M}${x}.jpg`} alt={k === 0 ? s.name : ''} class={k === 0 ? 'on' : ''} loading="lazy" />)}
              </div>
              <figcaption>{s.tags.join(', ')}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Процесс: 4 шага на тёмной полосе со звёздами, по линии бежит свет, у шагов инструменты -->
  <section class="xs" id="handover" aria-label="Process">
    <div class="xw">
      <p class="tag xtag"><i></i>Process</p>
      <h2 class="xh2 xh2--wide">A website your team runs <span>without us</span></h2>
      <p class="xho__lede">We design it, build it and hand it over. After that your team changes anything without waiting for us, and we are a message away if you need help.</p>
      <!-- тёмная полоса со звёздами как в футере: по линии бежит свет, шаги загораются по очереди -->
      <div class="xpr">
        <canvas class="stars" data-d=".35" aria-hidden="true"></canvas>
        <span class="xpr__line" aria-hidden="true"><i></i></span>
        <ol class="xpr__steps">
          {home.handover.map((h, i) => (
            <li style={`--k:${i}`}>
              <span class="xpr__node" aria-hidden="true" set:html={NODE[i]} />
              <span class="xpr__n">{pad(i + 1)} · {h.k}</span>
              <b>{h.t}</b>
              <p>{h.d}</p>
              <ul class="xpr__tools">{h.tools.map(t => <li>{t}</li>)}</ul>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 7. Созвон: сверху текст и цифры, календарь на всю ширину -->
  <section class="xs" id="team" aria-label="Contact">
    <div class="xw">
      <div class="x3 xt">
        <div class="s2">
          <p class="tag xtag"><i></i>Contact</p>
          <h2 class="xh2">Book a call with <span>the people who do the work</span></h2>
          <p class="xt__p">We are a team of 5 in Warsaw, no account managers in between. In 30 minutes you tell us what you are building, and we tell you what we would change on your website and how we can start. No sales pitch.</p>
        </div>
        <div class="xt__nums">
          <div><b>9</b><span>years</span></div>
          <div><b>100+</b><span>brands</span></div>
          <div><b>$130M+</b><span>raised by clients</span></div>
        </div>
      </div>
      <div class="xt__cal" id="xCal"><p>Loading calendar</p></div>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="xs" id="faq" aria-label="FAQ">
    <div class="xw x3 xfaq">
      <div><p class="tag xtag"><i></i>FAQ</p>
      <h2 class="xh2">Questions we get <span>on calls</span></h2></div>
      <div class="s2">{home.faq.map(f => <details class="fq"><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>

  <!-- плавающий чат «Ask us anything» -->
  <button class="chat-fab" type="button" aria-expanded="false" aria-controls="chat"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z"/></svg>Ask us anything</button>
  <div class="chat" id="chat" data-buy={BUY_CONCEPT} role="dialog" aria-label="Ask Unroot">
    <div class="chat__head">
      <button class="chat__x" type="button" aria-label="Close"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/></svg></button>
      <p class="chat__h">Ask us anything</p>
    </div>
    <div class="chat__log" aria-live="polite"></div>
    <div class="chat__chips"></div>
    <div class="chat__box">
      <form class="chat__in" autocomplete="off">
        <input type="text" name="q" placeholder="Type your question" aria-label="Your question" maxlength="200" />
        <button type="submit" aria-label="Send"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></button>
      </form>
      <div class="chat__sug"><ul></ul></div>
    </div>
    <button class="chat__reset mono" type="button">Start over</button>
  </div>
  <script type="application/json" id="chat-faq" set:html={JSON.stringify(home.faq)}></script>
</Base>

<script>import '../scripts/x.js'; import '../scripts/chat.js';</script>
