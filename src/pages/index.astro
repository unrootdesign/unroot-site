---
import "../styles/homepage.css";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="Unroot Design is a website design and build studio in Warsaw. Start with a $1,499 homepage concept delivered in 7 days.">
<meta name="theme-color" content="#21153D">
<title>Unroot Design | Website design and build for AI and tech startups</title>

</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<div class="shell">
  <aside class="rail">
    <div class="rail-brandrow"><a class="rail-logo" href="/">unroot<i>.</i></a><button class="command-mini" type="button" data-command-open><span>search</span><kbd>⌘K</kbd></button></div>
    <nav class="rnav" aria-label="Homepage">
      <a href="#concepts">concepts</a>
      <a href="#work">work</a>
      <a href="#pricing">pricing</a>
      <a href="#reviews">reviews</a>
      <a href="#services">services</a>
      <a href="#faq">faq</a>
    </nav>

    <div class="pitch">
      <h1>see your new homepage in <em>7 days</em>.</h1>
      <p>You send the link, we redesign the homepage. Then you decide if we build the rest.</p>
      <div class="nums">
        <div><b>9</b><s>years</s></div>
        <div><b>100+</b><s>brands</s></div>
        <div><b>$130M+</b><s>raised by clients</s></div>
      </div>
    </div>

    <div class="ctas"><a class="p3 " style="--face:#8961E7;--edge:#563898;--fg:#FFFFFF" href="mailto:adam@unroot.design?subject=Concept">
      <span class="p3__sh"></span>
      <span class="p3__face"><span class="prints"></span><b>get a concept</b><s>2 slots left</s></span></a><a class="p3 p3--light" style="--face:#F6C9B6;--edge:#D99C7C;--fg:#21153D" href="mailto:adam@unroot.design?subject=Intro%20call">
      <span class="p3__sh"></span>
      <span class="p3__face"><span class="prints"></span><b>book call</b><s>15 min</s></span></a></div>

    <p class="live">Warsaw <b data-clk="w">00<i>:</i>00</b></p>
  </aside>

  <main class="stream" id="main" tabindex="-1">

    <section id="concepts">
      <p class="sec__t">Concepts</p>
      <h2>every homepage here took 7 days</h2>

      <div class="tabs bd" role="tablist" aria-label="Concept preview format">
        <button id="tab-ba" aria-controls="pane-ba" tabindex="0" data-tab="ba" aria-selected="true" role="tab">before / after</button>
        <button id="tab-anim" aria-controls="pane-anim" tabindex="-1" data-tab="anim" aria-selected="false" role="tab">animated</button>
      </div>

      <div class="pane" id="pane-ba" role="tabpanel" aria-labelledby="tab-ba" data-pane="ba">
        <div class="bas"><figure class="ba" data-slug="javelin">
  <div class="ba__stage">
    <img class="ba__l" src="/homepage/img/p-javelin-before.jpg" alt="Javelin VP before" loading="lazy">
    <img class="ba__r" src="/homepage/img/p-javelin-after.jpg" alt="Javelin VP after" loading="lazy">
    <span class="ba__tag ba__tag--l">before</span><span class="ba__tag ba__tag--r">after</span>
    <span class="ba__bar"></span><span class="ba__knob">drag</span>
  </div>
  <figcaption><b>Javelin VP</b><span class="tag">venture</span></figcaption>
</figure><figure class="ba" data-slug="switch">
  <div class="ba__stage">
    <img class="ba__l" src="/homepage/img/p-switch-before.jpg" alt="Switch before" loading="lazy">
    <img class="ba__r" src="/homepage/img/p-switch-after.jpg" alt="Switch after" loading="lazy">
    <span class="ba__tag ba__tag--l">before</span><span class="ba__tag ba__tag--r">after</span>
    <span class="ba__bar"></span><span class="ba__knob">drag</span>
  </div>
  <figcaption><b>Switch</b><span class="tag">fintech</span></figcaption>
</figure><figure class="ba" data-slug="epsilon">
  <div class="ba__stage">
    <img class="ba__l" src="/homepage/img/p-epsilon-before.jpg" alt="Epsilon Health before" loading="lazy">
    <img class="ba__r" src="/homepage/img/p-epsilon-after.jpg" alt="Epsilon Health after" loading="lazy">
    <span class="ba__tag ba__tag--l">before</span><span class="ba__tag ba__tag--r">after</span>
    <span class="ba__bar"></span><span class="ba__knob">drag</span>
  </div>
  <figcaption><b>Epsilon Health</b><span class="tag">medtech</span></figcaption>
</figure><figure class="ba" data-slug="dreamie">
  <div class="ba__stage">
    <img class="ba__l" src="/homepage/img/p-dreamie-before.jpg" alt="Ambient Dreamie before" loading="lazy">
    <img class="ba__r" src="/homepage/img/p-dreamie-after.jpg" alt="Ambient Dreamie after" loading="lazy">
    <span class="ba__tag ba__tag--l">before</span><span class="ba__tag ba__tag--r">after</span>
    <span class="ba__bar"></span><span class="ba__knob">drag</span>
  </div>
  <figcaption><b>Ambient Dreamie</b><span class="tag">ai hardware</span></figcaption>
</figure><figure class="ba" data-slug="resumai">
  <div class="ba__stage">
    <img class="ba__l" src="/homepage/img/p-resumai-before.jpg" alt="ResumAI before" loading="lazy">
    <img class="ba__r" src="/homepage/img/p-resumai-after.jpg" alt="ResumAI after" loading="lazy">
    <span class="ba__tag ba__tag--l">before</span><span class="ba__tag ba__tag--r">after</span>
    <span class="ba__bar"></span><span class="ba__knob">drag</span>
  </div>
  <figcaption><b>ResumAI</b><span class="tag">ai tool</span></figcaption>
</figure><figure class="ba" data-slug="leadgains">
  <div class="ba__stage">
    <img class="ba__l" src="/homepage/img/p-leadgains-before.jpg" alt="Leadgains before" loading="lazy">
    <img class="ba__r" src="/homepage/img/p-leadgains-after.jpg" alt="Leadgains after" loading="lazy">
    <span class="ba__tag ba__tag--l">before</span><span class="ba__tag ba__tag--r">after</span>
    <span class="ba__bar"></span><span class="ba__knob">drag</span>
  </div>
  <figcaption><b>Leadgains</b><span class="tag">ai saas</span></figcaption>
</figure></div>
      </div>
      <div class="pane" id="pane-anim" role="tabpanel" aria-labelledby="tab-anim" data-pane="anim" hidden>
        <div class="ans"><figure class="an">
  <figcaption><b>Javelin VP</b><span class="tag">venture</span></figcaption>
  <div class="an__stage"><video src="/homepage/img/v-javelin.mp4" poster="/homepage/img/v-javelin.jpg"
    muted loop playsinline controls preload="none"></video></div>
</figure><figure class="an">
  <figcaption><b>Switch</b><span class="tag">fintech</span></figcaption>
  <div class="an__stage"><video src="/homepage/img/v-switch.mp4" poster="/homepage/img/v-switch.jpg"
    muted loop playsinline controls preload="none"></video></div>
</figure><figure class="an">
  <figcaption><b>Epsilon Health</b><span class="tag">medtech</span></figcaption>
  <div class="an__stage"><video src="/homepage/img/v-epsilon.mp4" poster="/homepage/img/v-epsilon.jpg"
    muted loop playsinline controls preload="none"></video></div>
</figure><figure class="an">
  <figcaption><b>Ambient Dreamie</b><span class="tag">ai hardware</span></figcaption>
  <div class="an__stage"><video src="/homepage/img/v-dreamie.mp4" poster="/homepage/img/v-dreamie.jpg"
    muted loop playsinline controls preload="none"></video></div>
</figure><figure class="an">
  <figcaption><b>ResumAI</b><span class="tag">ai tool</span></figcaption>
  <div class="an__stage"><video src="/homepage/img/v-resumai.mp4" poster="/homepage/img/v-resumai.jpg"
    muted loop playsinline controls preload="none"></video></div>
</figure><figure class="an">
  <figcaption><b>Leadgains</b><span class="tag">ai saas</span></figcaption>
  <div class="an__stage"><video src="/homepage/img/v-leadgains.mp4" poster="/homepage/img/v-leadgains.jpg"
    muted loop playsinline controls preload="none"></video></div>
</figure></div>
      </div>
    </section>



    <section id="play" class="play-sec">
      <p class="sec__t">Playground</p>
      <div class="play-head"><h2>9 concept covers</h2><p>Oramedia, ResumAI, Rezi, Switch, Wow House Studio, Ambient Dreamie, Epsilon Health, Javelin VP, Leadgains.</p></div>
      <p class="desk-help" id="desk-help">Drag a cover to explore. With a keyboard, focus a cover and use the arrow keys to move it.</p>
      <div class="playboard" data-playboard>
        <div class="drag-concept" data-drag-card tabindex="0" role="group" aria-describedby="desk-help"><img src="/homepage/img/c-javelin.jpg" alt="Javelin VP concept cover" loading="lazy" decoding="async"><span>Javelin VP</span></div>
        <div class="drag-concept" data-drag-card tabindex="0" role="group" aria-describedby="desk-help"><img src="/homepage/img/c-switch.jpg" alt="Switch concept cover" loading="lazy" decoding="async"><span>Switch</span></div>
        <div class="drag-concept" data-drag-card tabindex="0" role="group" aria-describedby="desk-help"><img src="/homepage/img/c-epsilon.jpg" alt="Epsilon Health concept cover" loading="lazy" decoding="async"><span>Epsilon Health</span></div>
        <div class="drag-concept" data-drag-card tabindex="0" role="group" aria-describedby="desk-help"><img src="/homepage/img/c-dreamie.jpg" alt="Ambient Dreamie concept cover" loading="lazy" decoding="async"><span>Ambient Dreamie</span></div>
        <div class="drag-concept" data-drag-card tabindex="0" role="group" aria-describedby="desk-help"><img src="/homepage/img/c-resumai.jpg" alt="ResumAI concept cover" loading="lazy" decoding="async"><span>ResumAI</span></div>
        <div class="drag-concept" data-drag-card tabindex="0" role="group" aria-describedby="desk-help"><img src="/homepage/img/c-leadgains.jpg" alt="Leadgains concept cover" loading="lazy" decoding="async"><span>Leadgains</span></div>
        <div class="drag-concept" data-drag-card tabindex="0" role="group" aria-describedby="desk-help"><img src="/homepage/img/c-oramedia.jpg" alt="Oramedia concept cover" loading="lazy" decoding="async"><span>Oramedia</span></div>
        <div class="drag-concept" data-drag-card tabindex="0" role="group" aria-describedby="desk-help"><img src="/homepage/img/c-rezi.jpg" alt="Rezi concept cover" loading="lazy" decoding="async"><span>Rezi</span></div>
        <div class="drag-concept" data-drag-card tabindex="0" role="group" aria-describedby="desk-help"><img src="/homepage/img/c-whs.jpg" alt="Wow House Studio concept cover" loading="lazy" decoding="async"><span>Wow House Studio</span></div>
        <button class="play-reset" data-play-reset type="button">reset desk</button>
      </div>
    </section>

    <section id="work" class="warm">
