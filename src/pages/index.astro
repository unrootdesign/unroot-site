<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Unroot Design is a 5 person website design and build studio in Warsaw for funded AI and tech startups.">
  <title>Unroot Design, website design and build for AI and tech startups</title>
  <style>
    :root{
      --ink:#0b0b0b;
      --paper:#f2f1ec;
      --card:#fbfaf6;
      --line:#d5d2c8;
      --muted:#706e67;
      --accent:#ff5f2e;
      --acid:#d9ff45;
      --blue:#4d67ff;
      --left:35vw;
      --radius:24px;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth;background:var(--paper)}
    body{margin:0;color:var(--ink);background:var(--paper);font-size:16px;line-height:1.35}
    body.command-open{overflow:hidden}
    button,input{font:inherit}
    button,a{color:inherit}
    a{text-decoration:none}
    button{cursor:pointer}
    ::selection{background:var(--acid);color:var(--ink)}

    .shell{display:grid;grid-template-columns:minmax(360px,var(--left)) 1fr;min-height:100vh}
    .rail{position:sticky;top:0;height:100vh;background:var(--ink);color:#fff;padding:22px 24px 24px;display:flex;flex-direction:column;overflow:hidden;z-index:10}
    .rail::after{content:"";position:absolute;width:330px;height:330px;right:-180px;bottom:-170px;border:1px solid #303030;border-radius:50%;box-shadow:0 0 0 45px #111,0 0 0 46px #303030,0 0 0 90px #111,0 0 0 91px #303030;pointer-events:none}
    .rail-top{display:flex;align-items:center;justify-content:space-between;gap:18px;position:relative;z-index:2}
    .logo{font-size:21px;font-weight:780;letter-spacing:-.055em}
    .logo span{color:var(--accent)}
    .command-button{border:1px solid #343434;background:#151515;color:#d8d8d8;border-radius:999px;padding:9px 10px 9px 13px;display:flex;align-items:center;gap:14px;font-size:12px}
    .command-button kbd,.command-launch kbd{font:inherit;background:#272727;border:1px solid #3b3b3b;border-radius:6px;padding:2px 6px;color:#fff}

    .hero{margin:auto 0 22px;position:relative;z-index:2}
    .availability{display:inline-flex;align-items:center;gap:8px;border:1px solid #303030;background:#121212;border-radius:999px;padding:7px 10px;margin-bottom:22px;color:#d4d4d4;font-size:12px}
    .availability i{width:7px;height:7px;border-radius:50%;background:var(--acid);box-shadow:0 0 0 4px rgba(217,255,69,.08)}
    h1{font-size:clamp(45px,4.65vw,76px);line-height:.93;letter-spacing:-.064em;margin:0;max-width:650px;font-weight:650}
    .hero-copy{font-size:17px;line-height:1.48;color:#a7a7a7;max-width:560px;margin:24px 0 0}
    .hero-copy strong{color:#fff;font-weight:560}
    .hero-actions{display:grid;grid-template-columns:1.25fr .75fr;gap:8px;margin-top:26px;max-width:560px}
    .btn{min-height:52px;border-radius:14px;border:1px solid #303030;display:flex;align-items:center;justify-content:space-between;padding:0 15px;font-weight:650;letter-spacing:-.02em}
    .btn-primary{background:var(--accent);color:#fff;border-color:var(--accent)}
    .btn-secondary{background:#151515;color:#fff}
    .btn span:last-child{font-size:18px}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#292929;border:1px solid #292929;border-radius:16px;overflow:hidden;margin-top:14px;max-width:560px}
    .stat{padding:13px 11px;background:#111}
    .stat strong{display:block;font-size:20px;letter-spacing:-.035em}
    .stat span{display:block;color:#777;font-size:10px;text-transform:uppercase;letter-spacing:.08em;margin-top:3px}
    .rail-foot{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;color:#777;font-size:11px;position:relative;z-index:2;border-top:1px solid #222;padding-top:15px}
    .rail-foot nav{display:flex;gap:14px;flex-wrap:wrap}
    .rail-foot a:hover{color:#fff}

    .feed{min-width:0}
    .feed-nav{height:72px;padding:0 24px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);position:sticky;top:0;background:rgba(242,241,236,.88);backdrop-filter:blur(16px);z-index:8}
    .feed-nav strong{font-size:12px;text-transform:uppercase;letter-spacing:.1em}
    .feed-nav nav{display:flex;gap:20px;font-size:13px}
    .feed-nav a{color:#625f58}
    .feed-nav a:hover{color:var(--ink)}
    .mobile-brand{display:none;font-weight:780;letter-spacing:-.05em}

    .section{padding:24px;border-bottom:1px solid var(--line)}
    .section-head{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:22px;align-items:end}
    .kicker{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:#7e7b73}
    .section-head h2{font-size:clamp(34px,4vw,66px);letter-spacing:-.055em;line-height:.94;margin:5px 0 0;font-weight:620}
    .section-head p{margin:0;color:#66645e;max-width:540px;font-size:15px}

    .concept-stage{border:1px solid var(--line);background:var(--card);border-radius:var(--radius);overflow:hidden}
    .concept-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px;border-bottom:1px solid var(--line)}
    .project-tabs{display:flex;gap:6px;flex-wrap:wrap}
    .project-tab{border:1px solid var(--line);background:transparent;border-radius:999px;padding:7px 10px;font-size:11px;color:#77746d}
    .project-tab.active{background:var(--ink);color:#fff;border-color:var(--ink)}
    .concept-price{font-size:11px;color:#66645e}
    .compare{position:relative;aspect-ratio:16/9;background:#e4e1d8;overflow:hidden;touch-action:none;user-select:none}
    .compare-panel{position:absolute;inset:0;display:grid;place-items:center;overflow:hidden}
    .compare-before{background:repeating-linear-gradient(135deg,#dfddd5 0,#dfddd5 18px,#eae8e1 18px,#eae8e1 36px)}
    .compare-after{background:linear-gradient(135deg,#131313 0 42%,#252525 42% 58%,#111 58% 100%);width:56%;right:auto}
    .mock-label{position:absolute;left:18px;bottom:18px;padding:8px 10px;border-radius:999px;background:rgba(255,255,255,.9);font-size:11px;z-index:3;white-space:nowrap}
    .compare-after .mock-label{background:var(--acid)}
    .fake-browser{width:70%;height:67%;border:1px solid rgba(20,20,20,.23);border-radius:10px;background:#f7f6f1;box-shadow:0 20px 50px rgba(0,0,0,.08);position:relative;padding:12px;display:grid;grid-template-rows:10px 1fr;gap:14px}
    .fake-browser::before{content:"";width:45px;height:6px;border-radius:999px;background:#cbc8be;box-shadow:55px 0 0 #d8d5cd,100px 0 0 #e1ded6}
    .wire{display:grid;grid-template-columns:.72fr 1.28fr;gap:12px}
    .wire div{border-radius:7px;background:#dedbd1}
    .wire div:first-child{background:#c7c3b9}
    .compare-after .fake-browser{background:#080808;border-color:#454545;box-shadow:0 25px 70px rgba(0,0,0,.45)}
    .compare-after .fake-browser::before{background:#343434;box-shadow:55px 0 0 #292929,100px 0 0 #202020}
    .compare-after .wire div{background:#232323}.compare-after .wire div:first-child{background:var(--accent)}
    .compare-handle{position:absolute;top:0;bottom:0;left:56%;width:2px;background:#fff;z-index:5;transform:translateX(-1px);pointer-events:none}
    .compare-handle::after{content:"↔";position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:39px;height:39px;border-radius:50%;background:#fff;display:grid;place-items:center;font-size:15px;box-shadow:0 4px 18px rgba(0,0,0,.16)}
    .compare-caption{display:grid;grid-template-columns:1.3fr .7fr;gap:20px;padding:15px 16px 17px;border-top:1px solid var(--line);font-size:13px}
    .compare-caption span:last-child{text-align:right;color:#75726b}

    .concept-details{display:grid;grid-template-columns:1.15fr .85fr;gap:12px;margin-top:12px}
    .offer-card,.mini-card{border:1px solid var(--line);background:var(--card);border-radius:20px;padding:18px}
    .offer-card h3{font-size:27px;letter-spacing:-.04em;margin:0 0 12px}
    .offer-card p{margin:0;color:#66645e;max-width:620px}
    .offer-points{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-top:18px;border-radius:12px;overflow:hidden}
    .offer-points div{background:var(--card);padding:12px;font-size:12px}
    .offer-points strong{display:block;font-size:15px;margin-bottom:4px}
    .mini-card{display:flex;flex-direction:column;justify-content:space-between;background:var(--acid);border-color:#c3e92d}
    .mini-card .big{font-size:46px;letter-spacing:-.06em;line-height:.9;font-weight:680}
    .mini-card p{margin:28px 0 0;font-size:13px;max-width:250px}

    .play-card{padding:18px;border:1px solid var(--line);border-radius:20px;background:#dedbd4;position:relative;overflow:hidden}
    .play-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px}
    .play-head p{font-size:12px;color:#6e6b64;margin:0}
    .reset{border:1px solid #aaa79e;border-radius:999px;background:rgba(255,255,255,.55);padding:7px 10px;font-size:11px}
    .board{height:330px;position:relative;border-radius:14px;background:#c8c4bb;overflow:hidden;background-image:linear-gradient(rgba(0,0,0,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(0,0,0,.035) 1px,transparent 1px);background-size:24px 24px}
    .drag{position:absolute;width:145px;aspect-ratio:4/3;border-radius:12px;padding:11px;border:1px solid rgba(0,0,0,.14);box-shadow:0 8px 25px rgba(0,0,0,.12);cursor:grab;touch-action:none;user-select:none;display:flex;flex-direction:column;justify-content:space-between;font-size:11px;font-weight:620}
    .drag:active{cursor:grabbing}.drag::after{content:"concept cover";font-size:9px;text-transform:uppercase;letter-spacing:.08em;opacity:.52}
    .drag:nth-child(1){left:7%;top:14%;background:#ff7450;transform:rotate(-5deg)}
    .drag:nth-child(2){left:30%;top:38%;background:#f7f5ee;transform:rotate(4deg)}
    .drag:nth-child(3){left:56%;top:11%;background:#3d50dc;color:#fff;transform:rotate(-2deg)}
    .drag:nth-child(4){left:75%;top:48%;background:#d9ff45;transform:rotate(5deg)}
    .drag:nth-child(5){left:13%;top:62%;background:#111;color:#fff;transform:rotate(2deg)}
    .drag:nth-child(6){left:51%;top:61%;background:#f0b9ff;transform:rotate(-4deg)}

    .work-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .case{border:1px solid var(--line);background:var(--card);border-radius:20px;overflow:hidden;transition:transform .2s ease,box-shadow .2s ease}
    .case:hover{transform:translateY(-3px);box-shadow:0 10px 30px rgba(24,22,18,.07)}
    .case-visual{aspect-ratio:16/9;display:grid;place-items:center;position:relative;overflow:hidden;border-bottom:1px solid var(--line)}
    .case:nth-child(1) .case-visual{background:#301941;color:#f0c9ff}
    .case:nth-child(2) .case-visual{background:#c9ff66;color:#0d0d0d}
    .case:nth-child(3) .case-visual{background:#111;color:#f5c849}
    .case:nth-child(4) .case-visual{background:#ced8ff;color:#1834a9}
    .case:nth-child(5) .case-visual{background:#ff7656;color:#28100a}
    .case:nth-child(6) .case-visual{background:#d9eee9;color:#0d5f51}
    .placeholder-caption{font-size:11px;text-transform:uppercase;letter-spacing:.1em;border:1px solid currentColor;border-radius:999px;padding:7px 9px}
    .case-content{padding:15px}
    .case-top{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}
    .case h3{font-size:24px;letter-spacing:-.04em;margin:0}
    .case-year{font-size:11px;color:#7b7870;padding-top:5px}
    .case p{font-size:13px;color:#68655e;margin:9px 0 16px;min-height:53px}
    .tags{display:flex;gap:5px;flex-wrap:wrap}
    .tag{font-size:10px;text-transform:uppercase;letter-spacing:.06em;border:1px solid var(--line);border-radius:999px;padding:5px 7px}

    .process{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:20px;overflow:hidden}
    .step{background:var(--card);padding:20px;min-height:210px;display:flex;flex-direction:column;justify-content:space-between}
    .step strong{font-size:12px;color:#77746d}.step h3{font-size:27px;letter-spacing:-.04em;margin:0 0 8px}.step p{font-size:13px;color:#69665f;margin:0}

    .pricing{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
    .price-card{border:1px solid var(--line);border-radius:20px;padding:18px;background:var(--card);display:flex;flex-direction:column;min-height:330px}
    .price-card.featured{background:var(--ink);color:#fff;border-color:var(--ink)}
    .price-card .label{font-size:11px;text-transform:uppercase;letter-spacing:.09em;color:#77746d}
    .price-card.featured .label{color:#8f8f8f}
    .price{font-size:47px;letter-spacing:-.06em;margin:12px 0 16px;line-height:1}
    .price-card p{font-size:13px;color:#6d6a63;margin:0 0 12px}.price-card.featured p{color:#aaa}
    .price-card .spacer{flex:1}
    .price-card a{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);padding-top:13px;font-weight:650;font-size:13px}.price-card.featured a{border-color:#333}

    .quotes{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
    .quote{border:1px solid var(--line);background:var(--card);border-radius:20px;padding:18px;display:flex;flex-direction:column;min-height:265px}
    .quote blockquote{margin:0;font-size:18px;letter-spacing:-.025em;line-height:1.35}
    .quote footer{margin-top:auto;padding-top:24px;display:flex;gap:10px;align-items:center;border:0}
    .avatar{width:38px;height:38px;border-radius:50%;border:1px dashed #999;background:#ece9e0;display:grid;place-items:center;font-size:9px;text-align:center;line-height:1.1;color:#77746d;flex:0 0 auto}
    .person{font-size:12px}.person strong{display:block}.person span{color:#77746d}

    .services-team{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .list-card{border:1px solid var(--line);background:var(--card);border-radius:20px;overflow:hidden}
    .list-title{padding:16px;border-bottom:1px solid var(--line);font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:#77746d}
    .list-row{padding:13px 16px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:12px;font-size:14px}.list-row:last-child{border-bottom:0}.list-row span:last-child{color:#7d7a72;text-align:right}

    .faq{border:1px solid var(--line);background:var(--card);border-radius:20px;overflow:hidden}
    details{border-bottom:1px solid var(--line)}details:last-child{border-bottom:0}
    summary{list-style:none;padding:17px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;cursor:pointer;font-size:17px;letter-spacing:-.025em}
    summary::-webkit-details-marker{display:none}
    summary::after{content:"+";font-size:24px;font-weight:300;color:#77746d}details[open] summary::after{content:"×"}
    details p{margin:0;padding:0 18px 18px;color:#68655e;max-width:740px;font-size:14px}

    .closing{border-radius:26px;background:var(--accent);color:#fff;padding:24px;min-height:390px;display:flex;flex-direction:column;justify-content:space-between}
    .closing-top{display:flex;justify-content:space-between;gap:18px;font-size:12px}
    .closing h2{font-size:clamp(48px,6vw,96px);line-height:.88;letter-spacing:-.065em;margin:40px 0 22px;max-width:890px;font-weight:640}
    .closing-actions{display:flex;gap:8px;flex-wrap:wrap}
    .closing .btn{background:#fff;color:var(--ink);border:0;min-width:180px}.closing .btn:last-child{background:#111;color:#fff}

    .footer{padding:24px;border-top:1px solid var(--line);background:#e8e5dc}
    .footer-grid{display:grid;grid-template-columns:1.2fr repeat(3,1fr);gap:28px}
    .footer h4{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:#7b7870;margin:0 0 11px}
    .footer a,.footer span{display:block;font-size:12px;margin:7px 0;color:#494741}
    .footer .big-mark{font-size:24px;font-weight:780;letter-spacing:-.05em;margin-bottom:10px;color:var(--ink)}
    .warsaw-time{margin-top:22px;font-size:11px;color:#77746d}

    .command-launch{position:fixed;right:18px;bottom:18px;z-index:20;border:1px solid #cfcac0;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);box-shadow:0 8px 30px rgba(0,0,0,.12);border-radius:14px;padding:12px 13px;display:flex;align-items:center;gap:11px;font-size:12px}
    .command-launch kbd{background:#efede7;border-color:#d7d3ca;color:#333}
    .command-launch .dot{width:8px;height:8px;border-radius:50%;background:var(--accent)}

    .overlay[hidden]{display:none}
    .overlay{position:fixed;inset:0;background:rgba(9,9,9,.58);backdrop-filter:blur(9px);z-index:100;display:grid;place-items:center;padding:20px}
    .palette{width:min(660px,100%);background:#f8f7f2;border:1px solid #d4d0c6;border-radius:20px;box-shadow:0 30px 90px rgba(0,0,0,.32);overflow:hidden}
    .palette-input{display:flex;align-items:center;gap:11px;padding:12px;border-bottom:1px solid var(--line)}
    .palette-input input{border:0;background:transparent;outline:0;flex:1;font-size:18px;padding:7px 2px;min-width:0}
    .palette-input kbd,.palette-foot kbd{font:inherit;font-size:10px;border:1px solid #d5d1c8;background:#ece9e2;border-radius:6px;padding:4px 6px}
    .palette-label{padding:12px 14px 5px;font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#8a877f}
    .palette-results{padding:7px}
    .result{display:grid;grid-template-columns:34px 1fr auto;align-items:center;gap:8px;padding:10px;border-radius:11px;font-size:13px}
    .result.active{background:#eae7df}.result[hidden]{display:none}
    .result-icon{width:30px;height:30px;border:1px solid #d7d2c9;border-radius:8px;display:grid;place-items:center;color:#68655e}
    .result small{color:#8a877f}.palette-empty{padding:18px 12px;color:#7c7972;font-size:13px}
    .palette-foot{display:flex;gap:16px;justify-content:flex-end;padding:10px 12px;border-top:1px solid var(--line);font-size:10px;color:#77746d}

    @media (max-width:1100px){
      :root{--left:40vw}
      .section-head{grid-template-columns:1fr}.work-grid,.quotes{grid-template-columns:1fr}.pricing{grid-template-columns:1fr}.price-card{min-height:250px}.services-team{grid-template-columns:1fr}.concept-details{grid-template-columns:1fr}.process{grid-template-columns:1fr}.step{min-height:160px}
    }
    @media (max-width:820px){
      .shell{display:block}.rail{position:relative;height:auto;min-height:720px;padding:18px 16px 20px}.rail-top{position:sticky;top:0}.hero{margin:120px 0 48px}.hero-actions{grid-template-columns:1fr}.stats{max-width:none}.rail-foot{display:none}.feed-nav{height:58px;padding:0 14px}.mobile-brand{display:block}.feed-nav strong{display:none}.feed-nav nav{gap:12px}.section{padding:16px 12px}.section-head{margin-bottom:16px}.compare-caption{grid-template-columns:1fr}.compare-caption span:last-child{text-align:left}.concept-toolbar{align-items:flex-start;flex-direction:column}.work-grid{grid-template-columns:1fr}.board{height:430px}.drag{width:125px}.drag:nth-child(1){left:5%;top:8%}.drag:nth-child(2){left:46%;top:19%}.drag:nth-child(3){left:12%;top:41%}.drag:nth-child(4){left:55%;top:55%}.drag:nth-child(5){left:7%;top:70%}.drag:nth-child(6){left:54%;top:79%}.footer-grid{grid-template-columns:1fr 1fr}.command-launch{left:12px;right:12px;justify-content:center;bottom:12px}.fake-browser{width:82%;height:70%}.closing{min-height:430px}
    }
    @media (max-width:520px){
      h1{font-size:51px}.hero-copy{font-size:15px}.stats{grid-template-columns:1fr}.stat{display:flex;align-items:baseline;gap:8px}.stat span{margin:0}.feed-nav nav a:nth-child(2){display:none}.section-head h2{font-size:43px}.offer-points{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr}.project-tabs{display:grid;grid-template-columns:repeat(3,1fr);width:100%}.project-tab{padding:7px 4px}.concept-price{display:none}.board{height:460px}.quotes{grid-template-columns:1fr}.process{display:block}.step{border-bottom:1px solid var(--line)}.pricing{display:block}.price-card{margin-bottom:10px}.closing h2{font-size:55px}.closing-actions{display:grid}.closing .btn{width:100%}
    }
    @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
  </style>
</head>
<body>
  <div class="shell">
    <aside class="rail">
      <div class="rail-top">
        <a class="logo" href="#top">unroot<span>.</span></a>
        <button class="command-button" type="button" data-open-command><span>Search</span><kbd>⌘K</kbd></button>
      </div>

      <div class="hero" id="top">
        <div class="availability"><i></i><span>2 slots left in October. Next opening December.</span></div>
        <h1>Website design and build for funded AI and tech startups.</h1>
        <p class="hero-copy"><strong>5 people in Warsaw.</strong> We work with pre-seed to Series A teams, mostly in the US, UK, Canada and Australia. Start with a 7 day concept.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#concept"><span>get a concept, $1,499</span><span>↘</span></a>
          <a class="btn btn-secondary" href="mailto:adam@unroot.design?subject=Intro%20call"><span>book call</span><span>↗</span></a>
