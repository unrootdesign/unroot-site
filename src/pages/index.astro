---
/* Экспериментальная главная (ветка next): сайт как пространство из 4 экранов.
   Навигация плавает снизу по центру, работы стоят коридором в перспективе, без 3D-движка. */
import Base from '../layouts/Base.astro';
import Tri from '../components/Tri.astro';
import logo from '../components/logo.svg?raw';
import { home } from '../data/home';
import { BUY_CONCEPT, CALL, SOCIAL } from '../data/links';
import '../styles/x.css';

// title и description дословно из Webflow
const title = "Design partner for AI and Tech founders | Unroot Design";
const description = "We design and build premium, custom websites with 3D & motion. We clarify complex products, ship in Webflow, and lift conversions with fast weekly sprints.";

const M = '/home/';
const pad = (n: number) => String(n).padStart(2, '0');
const logoSvg = logo.replace('<svg ', '<svg class="x-logo__svg" aria-hidden="true" ');
const schema = [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: home.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];

// коридор: 4 кадра каждого проекта подряд
const frames = home.work.flatMap((w, p) =>
  Array.from({ length: 4 }, (_, k) => ({ w, p, k, src: `${M}w-${w.slug}-${k + 1}.jpg` })));
const plans = [
  { n: 'Homepage concept', p: '$1,499', s: 'one-off', d: '1 animated homepage direction in 7 days' },
  { n: 'Design and Build Sprint', p: '$2,499', s: '/ week', d: '1 week of design, build or both' },
  { n: 'Monthly Design and Build', p: '$7,899', s: '/ month', d: 'A senior designer and a senior developer' },
];
const views = [
  { id: 'works', label: 'Works' },
  { id: 'concepts', label: 'Concepts' },
  { id: 'about', label: 'About' },
  { id: 'contact', label: 'Contact' },
];
---
<Base title={title} description={description} schema={schema} bodyClass="x" bare>
  <div class="x-app" data-view="works">

    <header class="x-top">
      <a href="/" class="x-logo" aria-label="Unroot Design, home" set:html={logoSvg} />
      <span class="x-crumb" aria-hidden="true">/ <span id="xCrumb">Works</span></span>
      <a class="x-topcta" href={BUY_CONCEPT}>Get a concept, $1,499 <Tri /></a>
    </header>

    <!-- 1. Работы: коридор из кадров -->
    <section class="xv on" data-v="works" aria-label="Works">
      <div class="xw" id="xw">
        {frames.map((f, i) => (
          <a class="xf" data-i={i} data-p={f.p} href={f.w.cs ? `/case-studies/${f.w.cs}` : f.w.url} aria-label={`${f.w.name}, image ${f.k + 1}`}>
            <img src={f.src} alt={f.w.name} width="1600" height="900" loading={i < 6 ? 'eager' : 'lazy'} decoding="async" />
            {f.k === 0 && <span class="xf__l">{f.w.name} <i>/ {f.w.kind}</i></span>}
          </a>
        ))}
      </div>
      <div class="xw-hero" id="xwHero">
        <p class="xw-hero__k">Website design and build for AI and tech startups</p>
        <h1 class="xw-hero__h">Your new homepage <span>in 7&nbsp;days</span></h1>
        <p class="xw-hero__s">Click through your new homepage first. Then we build the full website, and your team runs it with&nbsp;AI.</p>
        <p class="xw-hero__hint"><span class="xw-mouse" aria-hidden="true"></span>Scroll to walk through our websites</p>
      </div>
      <div class="xw-hud" id="xwHud" aria-live="polite">
        {home.work.map((w, p) => (
          <div class={`xw-hud__p${p === 0 ? ' on' : ''}`} data-p={p}>
            <p class="xw-hud__n">{w.name} <span>{w.kind}</span></p>
            {w.stat ? <p class="xw-hud__s"><b>{w.stat}</b> {w.statLabel}</p> : <p class="xw-hud__s">{w.desc.split('.')[0]}</p>}
            <a class="xw-hud__go" href={w.cs ? `/case-studies/${w.cs}` : w.url}>View case study <Tri /></a>
          </div>
        ))}
      </div>
    </section>

    <!-- 2. Концепты: до и после -->
    <section class="xv" data-v="concepts" aria-label="Concepts" hidden>
      <div class="xc">
        <div class="xc__txt">
          <p class="x-label">Concepts</p>
          <h2 class="xc__h">See the direction before you commit</h2>
          <p class="xc__s">You send a link. In 7 days you click through your homepage, redesigned from scratch. Drag across the picture to compare.</p>
          <a class="x-btn" href={BUY_CONCEPT}>Get a concept, $1,499 <Tri /></a>
        </div>
        <figure class="xc__stage ba">
          <div class="ba__stage">
            {home.ba.map((p, i) => (
              <div class={`xc__pair${i === 0 ? ' on' : ''}`} data-i={i}>
                <img class="ba__l" src={`${M}p-${p.slug}-before.jpg`} alt={`${p.name} before`} loading="lazy" />
                <img class="ba__r" src={`${M}p-${p.slug}-after.jpg`} alt={`${p.name} after`} loading="lazy" />
              </div>
            ))}
            <span class="xc__tag xc__tag--l">Before</span><span class="xc__tag xc__tag--r">After</span>
            <span class="ba__bar"><i></i></span>
          </div>
        </figure>
        <ol class="xc__list" aria-label="Concepts">
          {home.ba.map((p, i) => (
            <li><button type="button" class={i === 0 ? 'on' : ''} data-i={i}><span>{pad(i + 1)}</span>{p.name}</button></li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 3. О студии: 4 карточки -->
    <section class="xv" data-v="about" aria-label="About" hidden>
      <div class="xa" id="xa">
        <div class="xa__col">
          <p class="x-label">Studio</p>
          <article class="xa__card xa__card--studio">
            <h2>We design and build websites for AI and tech startups.</h2>
            <p>Figma plus vibe coding: you see your new homepage working in 7 days, then we build the rest and set it up so your team edits it with AI.</p>
            <div class="xa__chips">
              <p>Works with</p>
              <ul><li>AI</li><li>SaaS</li><li>Fintech</li><li>Healthtech</li></ul>
              <p>Services</p>
              <ul><li>Website design</li><li>Webflow and Framer</li><li>Brand identity</li><li>AI setup</li></ul>
            </div>
          </article>
        </div>
        <div class="xa__col">
          <p class="x-label">In numbers</p>
          <article class="xa__card xa__card--num">
            <div><span>years</span><b>9</b></div>
            <div><span>brands</span><b>100+</b></div>
            <div><span>raised by clients</span><b>$130M+</b></div>
          </article>
        </div>
        <div class="xa__col">
          <p class="x-label">Clients</p>
          <article class="xa__card xa__card--q" id="xq">
            {home.quotes.map((q, i) => (
              <blockquote class={i === 0 ? 'on' : ''}>
                <p>&ldquo;{q.text}&rdquo;</p>
                <footer><img src={`${M}av-${q.avatar}.jpg`} alt="" width="40" height="40" loading="lazy" /><span><b>{q.name}</b>{q.role}</span></footer>
              </blockquote>
            ))}
            <div class="xa__dots">{home.quotes.map((_, i) => <button type="button" class={i === 0 ? 'on' : ''} data-i={i} aria-label={`Quote ${i + 1}`}></button>)}</div>
          </article>
        </div>
        <div class="xa__col">
          <p class="x-label">Pricing</p>
          <article class="xa__card xa__card--price">
            {plans.map((p, i) => (
              <div class={i === 0 ? 'first' : ''}>
                <p class="xa__pn">{p.n}</p>
                <p class="xa__pp">{p.p}<small>{p.s}</small></p>
                <p class="xa__pd">{p.d}</p>
              </div>
            ))}
            <a class="x-btn x-btn--full" href={BUY_CONCEPT}>Get a concept, $1,499 <Tri /></a>
          </article>
        </div>
      </div>
    </section>

    <!-- 4. Контакт: концепт или созвон -->
    <section class="xv" data-v="contact" aria-label="Contact" hidden>
      <div class="xk">
        <div class="xk__col">
          <p class="x-label">Start here</p>
          <article class="xa__card xk__card">
            <h2>Start with a concept</h2>
            <p class="xk__p">$1,499 <small>delivered in 7 days</small></p>
            <ul class="xk__list">
              <li>3–4 homepage sections with our direction for your product</li>
              <li>A live preview you can click through and share with your team</li>
              <li>The files are yours to keep and build on</li>
              <li>The $1,499 goes toward the full website if you start within 60 days</li>
            </ul>
            <a class="x-btn x-btn--full" href={BUY_CONCEPT}>Get a concept, $1,499 <Tri /></a>
            <p class="xk__soc">{SOCIAL.map(s => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</p>
          </article>
        </div>
        <div class="xk__col xk__col--cal">
          <p class="x-label">Or book a 30 minute call</p>
          <div class="xa__card xk__cal" id="xCal"><p class="xk__load">Loading calendar</p></div>
        </div>
      </div>
    </section>

    <!-- навигация снизу по центру -->
    <nav class="x-dock" aria-label="Sections">
      <div class="x-dock__tabs" role="tablist">
        {views.map((v, i) => <button type="button" role="tab" data-v={v.id} aria-selected={i === 0 ? 'true' : 'false'}>{v.label}</button>)}
      </div>
      <span class="x-dock__sep" aria-hidden="true"></span>
      <div class="x-dock__nav">
        <button type="button" class="x-dock__arr" id="xPrev" aria-label="Previous"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 3.5 5.5 8l4.5 4.5"/></svg></button>
        <span class="x-dock__count" id="xCount">01 / {pad(frames.length)}</span>
        <button type="button" class="x-dock__arr" id="xNext" aria-label="Next"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3.5 10.5 8 6 12.5"/></svg></button>
      </div>
      <span class="x-dock__sep" aria-hidden="true"></span>
      <button type="button" class="x-dock__help" id="xHelpBtn" aria-expanded="false" aria-controls="xHelp">?</button>
      <div class="x-help" id="xHelp" hidden>
        <p><b>Scroll</b> or drag to move</p>
        <p><b>← →</b> previous and next</p>
        <p><b>1–4</b> switch sections</p>
      </div>
    </nav>
  </div>
</Base>

<script>import '../scripts/x.js';</script>
