---
/* Экспериментальная главная (ветка next): одна страница с прокруткой, сверху общая навигация с мега-меню.
   Герой: заголовок и до/после, которые сменяются сами. Дальше ряд работ (тянется мышью), отзывы, цены,
   услуги, после запуска, созвон, FAQ и обычный футер. Все секции в одном контейнере --wrap. */
import Base from '../layouts/Base.astro';
import Tri from '../components/Tri.astro';
import { home } from '../data/home';
import { BUY_CONCEPT, CALL } from '../data/links';
import '../styles/x.css';
import '../styles/chat.css';

// title и description дословно из Webflow
const title = "Design partner for AI and Tech founders | Unroot Design";
const description = "We design and build premium, custom websites with 3D & motion. We clarify complex products, ship in Webflow, and lift conversions with fast weekly sprints.";

const M = '/home/';
const pad = (n: number) => String(n).padStart(2, '0');
const schema = [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: home.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
---
<Base title={title} description={description} schema={schema} bodyClass="x" crumb="concept">
  <!-- 1. Герой: заголовок слева, до и после справа, сменяются сами -->
  <section class="xs xhero" id="concept" data-mode="ba" aria-label="Concept">
    <div class="xw xhero__in">
      <div class="xhero__txt">
        <p class="xhero__k">Website design and build for AI and tech startups</p>
        <h1 class="xhero__h">Your new homepage <span>in 7&nbsp;days</span></h1>
        <p class="xhero__s">Click through your new homepage first. Then we build the full website, and your team runs it with&nbsp;AI.</p>
        <div class="xhero__ctas">
          <a class="x-btn" href={BUY_CONCEPT}>Get a concept, $1,499 <Tri /></a>
          <a class="x-btn x-btn--line" href={CALL}>Discuss a project <Tri /></a>
        </div>
        <div class="xhero__nums">
          <div><b>9</b><span>years</span></div>
          <div><b>100+</b><span>brands</span></div>
          <div><b>$130M+</b><span>raised by clients</span></div>
        </div>
      </div>

      <div class="xhero__vis">
        <div class="xhero__bar">
          <div class="xc__mode" role="tablist" aria-label="Show">
            <button type="button" role="tab" data-mode="ba" aria-selected="true">Before / after</button>
            <button type="button" role="tab" data-mode="anim" aria-selected="false">Animated</button>
          </div>
          <p class="xhero__name" id="xName">{home.ba[0].name}</p>
        </div>
        <div class="xc__stage xc__stage--ba">
          {home.ba.map((p, i) => (
            <div class={`xc__pair${i === 0 ? ' on' : ''}`} data-i={i} data-name={p.name}>
              <figure><figcaption>Before</figcaption><img src={`${M}p-${p.slug}-before.jpg`} alt={`${p.name} before`} width="620" height="1033" loading={i === 0 ? 'eager' : 'lazy'} /></figure>
              <span class="xc__arrow" aria-hidden="true">→</span>
              <figure><figcaption class="after">After, 7 days later</figcaption><img src={`${M}p-${p.slug}-after.jpg`} alt={`${p.name} after`} width="620" height="1033" loading={i === 0 ? 'eager' : 'lazy'} /></figure>
            </div>
          ))}
        </div>
        <div class="xc__stage xc__stage--anim">
          {home.pairs.map((p, i) => (
            <div class={`xc__vid${i === 0 ? ' on' : ''}`} data-i={i} data-name={p.name}>
              <video src={`${M}v-${p.slug}.mp4`} poster={`${M}v-${p.slug}.jpg`} muted loop playsinline preload="none"></video>
            </div>
          ))}
        </div>
        <div class="xhero__dots xhero__dots--ba">{home.ba.map((p, i) => <button type="button" class={i === 0 ? 'on' : ''} data-i={i} aria-label={p.name}><i></i></button>)}</div>
        <div class="xhero__dots xhero__dots--anim">{home.pairs.map((p, i) => <button type="button" class={i === 0 ? 'on' : ''} data-i={i} aria-label={p.name}><i></i></button>)}</div>
      </div>
    </div>
  </section>

  <!-- 2. Работы: без заголовка, ряд тянется мышью -->
  <section class="xs xwork" id="work" aria-label="Work">
    <div class="xwork__row" id="xRow">
      {home.work.map(w => {
        const href = w.cs ? `/case-studies/${w.cs}` : w.url;
        return (
          <article class="xg">
            <a class="xg__head" href={href}><b>{w.name}</b> {w.kind}</a>
            <a class="xg__main" href={href} aria-label={`${w.name}, case study`}>
              {[1, 2, 3, 4].map(k => <img src={`${M}w-${w.slug}-${k}.jpg`} alt={k === 1 ? w.name : ''} class={k === 1 ? 'on' : ''} data-k={k} width="1600" height="900" loading="lazy" decoding="async" draggable="false" />)}
            </a>
            <div class="xg__thumbs">
              {[2, 3, 4].map(k => <button type="button" data-k={k} aria-label={`${w.name}, image ${k}`}><img src={`${M}w-${w.slug}-${k}.jpg`} alt="" width="1600" height="900" loading="lazy" decoding="async" draggable="false" /></button>)}
            </div>
            <div class="xg__foot">
              {w.stat ? <p class="xg__stat"><b>{w.stat}</b> {w.statLabel}</p> : <p class="xg__stat">{w.desc.split('.')[0]}</p>}
              <a class="xg__go" href={href}>View case study <Tri /></a>
            </div>
          </article>
        );
      })}
      <div class="xg xg--next">
        <p class="xg__nk">Your website</p>
        <p class="xg__nh">Could be next in this row</p>
        <a class="x-btn" href={BUY_CONCEPT}>Get a concept, $1,499 <Tri /></a>
      </div>
    </div>
  </section>

  <!-- 3. Отзывы -->
  <section class="xs" id="reviews" aria-label="Reviews">
    <div class="xw">
      <h2 class="xh2">What they say <span>after</span></h2>
      <div class="xq" id="xq">
        {home.quotes.map((q, i) => (
          <blockquote class={i === 0 ? 'on' : ''}>
            <p>&ldquo;{q.text}&rdquo;</p>
            <footer>
              <img src={`${M}av-${q.avatar}.jpg`} alt="" width="44" height="44" loading="lazy" />
              <span><b>{q.name}</b>{q.role}</span>
              {q.url && <a href={q.url} target="_blank" rel="noopener">Verified on Trustpilot ↗</a>}
            </footer>
          </blockquote>
        ))}
        <div class="xq__nav">
          <button type="button" class="xq__arr" data-d="-1" aria-label="Previous review">←</button>
          <button type="button" class="xq__arr" data-d="1" aria-label="Next review">→</button>
          <span id="xqn">{pad(1)} / {pad(home.quotes.length)}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Цены: 2 формата работы и концепт для тех, кто не знает, с чего начать -->
  <section class="xs" id="pricing" aria-label="Pricing">
    <div class="xw">
      <h2 class="xh2">Pick how we <span>work together</span></h2>
      <div class="xp">
        <article class="xp__c">
          <p class="xp__n">Design and Build Sprint</p>
          <p class="xp__p">$2,499<small>/ week</small></p>
          <p class="xp__d">1 week of design, build or both. Ends on Friday, no notice period.</p>
          <a class="x-btn x-btn--line x-btn--full" href={CALL}>Discuss a project <Tri /></a>
        </article>
        <article class="xp__c">
          <p class="xp__n">Monthly Design and Build</p>
          <p class="xp__p">$7,899<small>/ month</small></p>
          <p class="xp__d">4 weeks with a senior designer and a senior developer. Handover and AI setup included. Pause or stop after any month.</p>
          <a class="x-btn x-btn--line x-btn--full" href={CALL}>Discuss a project <Tri /></a>
        </article>
        <article class="xp__c xp__c--concept">
          <p class="xp__n">Not sure where to start?</p>
          <p class="xp__p">$1,499<small>homepage concept, 7 days</small></p>
          <ul class="xp__list">
            <li>3–4 homepage sections with our direction for your product</li>
            <li>A live preview you can click through and share with your team</li>
            <li>The files are yours to keep and build on</li>
            <li>The $1,499 goes toward the full website if you start within 60 days</li>
          </ul>
          <a class="x-btn x-btn--full" href={BUY_CONCEPT}>Get a concept, $1,499 <Tri /></a>
        </article>
      </div>
    </div>
  </section>

  <!-- 5. Услуги -->
  <section class="xs" id="services" aria-label="Services">
    <div class="xw">
      <h2 class="xh2">What we <span>do</span></h2>
      <div class="xsv">
        <ol class="xsv__list">
          {home.services.map((s, i) => <li><button type="button" class={i === 0 ? 'on' : ''} data-i={i}><span>{pad(i + 1)}</span>{s.name}</button></li>)}
        </ol>
        <div class="xsv__media">
          {home.services.map((s, i) => (
            <figure class={`xsv__m${i === 0 ? ' on' : ''}`} data-i={i}>
              {s.video
                ? <video src={`${M}${s.video}.mp4`} poster={`${M}${s.video}.jpg`} muted loop playsinline preload="none"></video>
                : <img src={`${M}${s.images[0]}.jpg`} alt={s.name} loading="lazy" />}
              <figcaption>{s.tags.join(', ')}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 6. После запуска -->
  <section class="xs" id="handover" aria-label="After launch">
    <div class="xw">
      <h2 class="xh2">A website your team runs <span>without us</span></h2>
      <ol class="xho">
        {home.handover.map((h, i) => <li><span>{pad(i + 1)}</span><b>{h.t}</b><p>{h.d}</p></li>)}
      </ol>
    </div>
  </section>

  <!-- 7. Созвон -->
  <section class="xs" id="team" aria-label="Contact">
    <div class="xw xt">
      <div class="xt__txt">
        <h2 class="xh2">Book a call with <span>the people who do the work</span></h2>
        <p>We are a team of 5 in Warsaw, no account managers in between. In 30 minutes you tell us what you are building, and we tell you what we would change on your website and how we can start. No sales pitch.</p>
      </div>
      <div class="xt__cal" id="xCal"><p>Loading calendar</p></div>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="xs" id="faq" aria-label="FAQ">
    <div class="xw xfaq">
      <h2 class="xh2">Questions we get <span>on calls</span></h2>
      <div>{home.faq.map(f => <details class="fq"><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>

  <!-- плавающий чат «Ask us anything» -->
  <button class="chat-fab" type="button" aria-expanded="false" aria-controls="chat"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z"/></svg>Ask us anything</button>
  <div class="chat" id="chat" data-buy={BUY_CONCEPT} role="dialog" aria-label="Ask Unroot">
    <div class="chat__head">
      <button class="chat__x" type="button" aria-label="Close"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/></svg></button>
      <p class="chat__h">Ask us anything</p>
    </div>
    <div class="chat__log" aria-live="polite"></div>
    <div class="chat__chips"></div>
    <div class="chat__box">
      <form class="chat__in" autocomplete="off">
        <input type="text" name="q" placeholder="Ask us anything..." aria-label="Ask us anything" maxlength="200" />
        <button type="submit" aria-label="Send"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></button>
      </form>
      <div class="chat__sug"><ul></ul></div>
    </div>
    <button class="chat__reset mono" type="button">Start over</button>
  </div>
  <script type="application/json" id="chat-faq" set:html={JSON.stringify(home.faq)}></script>
</Base>

<script>import '../scripts/x.js'; import '../scripts/chat.js';</script>
