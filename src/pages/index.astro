---
import Base from '../layouts/Base.astro';
import Tri from '../components/Tri.astro';
import { home } from '../data/home';
import { BUY_CONCEPT, CALL } from '../data/links';
import '../styles/home.css';

// title и description дословно из Webflow
const title = "Design partner for AI and Tech founders | Unroot Design";
const description = "We design and build premium, custom websites with 3D & motion. We clarify complex products, ship in Webflow, and lift conversions with fast weekly sprints.";

const M = '/home/';
const host = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
const pad = (n: number) => String(n).padStart(2, '0');
const schema = [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: home.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
---
<Base title={title} description={description} schema={schema} bodyClass="home">
  <div class="shell">
    <aside class="rail">
      <div class="rail__mid">
        <p class="tag"><i></i>Website design and build</p>
        <h1 class="h1 rv">Your new homepage <span class="acc">in <span class="nw">7 days</span></span></h1>
        <p class="lede">Click through your new homepage first. Then we build the full website, and your team runs it with AI.</p>
        <div class="ctas">
          <a class="btn btn--main" href={BUY_CONCEPT}><span>Get a concept, <span class="nw">$1,499</span></span><Tri /></a>
          <a class="btn btn--line" href={CALL}><span>Discuss a project</span><Tri /></a>
        </div>
      </div>
      <div class="facts">
        <div><b>9</b><s>years</s></div>
        <div><b>100+</b><s>brands</s></div>
        <div><b>$130M+</b><s>raised by clients</s></div>
      </div>
    </aside>

    <div class="stream">
      <section class="sec" id="concept">
        <p class="tag"><i></i>Concept</p>
        <h2 class="h2 rv">See the direction <span class="acc">before you commit</span></h2>
        <p class="sub">You send a link, we redesign the homepage from scratch. Drag the slider to see what changed.</p>

        <div class="tabs" role="tablist">
          <button data-tab="ba" aria-selected="true" role="tab" type="button">Before / after</button>
          <button data-tab="anim" aria-selected="false" role="tab" type="button">Animated</button>
        </div>
        <div class="pane" data-pane="ba"><div class="bas">
          {home.ba.map(p => (
            <figure class="ba">
              <div class="ba__stage">
                <img class="ba__l" src={`${M}p-${p.slug}-before.jpg`} alt={`${p.name} before`} loading="lazy" />
                <img class="ba__r" src={`${M}p-${p.slug}-after.jpg`} alt={`${p.name} after`} loading="lazy" />
                <span class="ba__tag ba__tag--l">Before</span><span class="ba__tag ba__tag--r">After</span>
                <span class="ba__bar"><i></i></span>
              </div>
              <figcaption><span>{p.name}</span><span>7 day concept</span></figcaption>
            </figure>
          ))}
        </div></div>
        <div class="pane" data-pane="anim" hidden><div class="ans">
          {home.pairs.map(p => (
            <figure class="an">
              <div class="an__stage"><video src={`${M}v-${p.slug}.mp4`} poster={`${M}v-${p.slug}.jpg`} muted loop playsinline preload="none"></video></div>
              <figcaption><span>{p.name}</span><span>{p.label}</span></figcaption>
            </figure>
          ))}
        </div></div>

        <div class="ob" id="offer">
          <canvas class="stars" aria-hidden="true"></canvas>
          <p class="ob__k">Homepage concept &middot; $1,499</p>
          <div class="ob__b">
            <h3 class="ob__h">Want one for your website?</h3>
            <p class="ob__s">Animated and interactive, Figma plus vibe coding. In your inbox in 7&nbsp;days.</p>
          </div>
          <a class="btn btn--main" href={BUY_CONCEPT}><span>Get a concept</span><Tri /></a>
        </div>
      </section>

      <section class="sec" id="work">
        <p class="tag"><i></i>Work</p>
        <h2 class="h2 rv">Concepts that turned <span class="acc">into websites</span></h2>
        <div class="ans wk bd">
          {home.work.map(w => (
            <article class="an wk__c">
              <a class="an__stage win__v" href={w.cs ? `/case-studies/${w.cs}` : w.url} target={w.cs ? undefined : '_blank'} rel={w.cs ? undefined : 'noopener'} aria-label={`${w.name}, ${w.cs ? 'case study' : 'website'}`}>{Array.from({ length: w.shots }, (_, k) => k + 1).map(i => <img src={`${M}w-${w.slug}-${i}.jpg`} alt={w.name} class={i === 1 ? 'on' : ''} loading="lazy" />)}</a>
              <span class="wk__cap"><span class="wk__t"><span class="wk__n">{w.name}</span><span class="wk__k">{w.kind}</span></span>
                <span class="wk__acts">
                  {w.cs && <a class="wk__web" href={w.url} target="_blank" rel="noopener">Website <svg class="ars" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><path d="M4.5 11.5l7-7M5.5 4.5h6v6"/></svg></a>}
                  <a class="wk__go" href={w.cs ? `/case-studies/${w.cs}` : w.url} target={w.cs ? undefined : '_blank'} rel={w.cs ? undefined : 'noopener'}>{w.cs ? 'View case study' : 'Visit the website'} <Tri /></a>
                </span></span>
              <span class="wk__b">{w.desc}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="sec" id="reviews">
        <p class="tag"><i></i>Clients</p>
        <h2 class="h2 rv">What they say <span class="acc">after</span></h2>
        <div class="bd">
          <div class="qwrap">
            {home.quotes.map((q, i) => (
              <article class={`q${i === 0 ? ' on' : ''}`}>
                <p>&ldquo;{q.text}&rdquo;</p>
                <footer>
                  <span class="q__l"><span class="q__who"><img src={`${M}av-${q.avatar}.jpg`} alt={q.name} loading="lazy" /><span><b>{q.name}</b><s>{q.role}</s></span></span></span>
                  {q.url && <a href={q.url} target="_blank" rel="noopener" class="q__tp">Verified on Trustpilot <svg class="ars" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><path d="M4.5 11.5l7-7M5.5 4.5h6v6"/></svg></a>}
                </footer>
              </article>
            ))}
          </div>
          <div class="sl__nav">
            <button class="arrow" id="qPrev" type="button" aria-label="Previous review"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"><path d="M19 12H5"/><path d="m11 18-6-6 6-6"/></svg></button>
            <button class="arrow" id="qNext" type="button" aria-label="Next review"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></button>
            <span class="qn" id="qn">01 / {pad(home.quotes.length)}</span>
          </div>
        </div>
      </section>

      <section class="sec" id="pricing">
        <p class="tag"><i></i>Working together</p>
        <h2 class="h2 rv">Start with a concept <span class="acc">then decide</span></h2>
        <div class="bd">
          <div class="pk">
            <div>
              <p class="pk__top"><span>Homepage concept</span><span class="pk__flag">Start here</span></p>
              <p class="pk__p">$1,499<small>one-off</small></p>
              <p class="pk__d">1 animated, interactive homepage direction, delivered in 7&nbsp;days.</p>
              <a class="btn btn--main" href={BUY_CONCEPT}><span>Get a concept</span><Tri /></a>
              <ul class="pk__list">
              <li>3–4 homepage sections with our direction for your product</li>
              <li>A live preview you can click through and share with your team</li>
              <li>The files are yours to keep and build on</li>
              <li>The $1,499 goes toward the full website if you start within 60 days</li>
              </ul>
            </div>
            <div class="pk__r">
            <div class="pk__v" aria-label="Concept examples">
              {home.pairs.map((p, i) => <video class={i === 0 ? 'on' : ''} src={`${M}v-${p.slug}.mp4`} poster={`${M}v-${p.slug}.jpg`} muted loop playsinline preload="none" data-lazy aria-label={`${p.name} concept`}></video>)}
            </div>
              <p class="pk__vn mono">{home.pairs.map((p, i) => <span class={i === 0 ? 'on' : ''}>{p.name}</span>)}</p>
            </div>
          </div>
          <div class="pns">
            <div class="pn">
              <p class="pn__n">Design and Build Sprint</p>
              <p class="pn__p">$2,499<small>/ week</small></p>
              <p class="pn__d">1 week of design, build or both. Ends on Friday, no notice period.</p>
              <a class="pn__go" href={CALL}>Discuss a project <Tri /></a>
            </div>
            <div class="pn">
              <p class="pn__n">Monthly Design and Build</p>
              <p class="pn__p">$7,899<small>/ month</small></p>
              <p class="pn__d">4 weeks with a senior designer and a senior developer. Handover and AI setup included. Pause or stop after any month.</p>
              <a class="pn__go" href={CALL}>Discuss a project <Tri /></a>
            </div>
          </div>
        </div>
      </section>

      <section class="sec" id="services">
        <p class="tag"><i></i>Services</p>
        <h2 class="h2 rv">What we <span class="acc">do</span></h2>
        <div class="svx bd">
          <ul class="svl">
            {home.services.map((s, i) => <li class={`sv${i === 0 ? ' on' : ''}`} data-i={i}><span class="idx">{pad(i + 1)}</span><b>{s.name}</b></li>)}
          </ul>
          <div class="svm">
            {home.services.map((s, i) => (
              <div class={`svm__l${i === 0 ? ' on' : ''}`} data-i={i}>
                <div class="svm__st"><div class="svm__v" style={`aspect-ratio:${s.ratio}`}><div class="svm__in">
                  {s.video
                    ? <video class="svv" src={`${M}${s.video}.mp4`} poster={`${M}${s.video}.jpg`} muted loop playsinline preload="none"></video>
                    : s.images.map((x, k) => <img src={`${M}${x}.jpg`} alt={s.name} class={k === 0 ? 'on' : ''} loading="lazy" />)}
                </div></div></div>
                <div class="svm__r mono"><span>{s.tags.join(' · ')}</span><span>{pad(i + 1)} / {pad(home.services.length)}</span></div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="sec" id="handover">
        <p class="tag"><i></i>After launch</p>
        <h2 class="h2 rv">A website your team runs <span class="acc">without us</span></h2>
        <ol class="yr bd">
          {home.handover.map((h, i) => <li><span class="mono">{pad(i + 1)}</span><b>{h.t}</b><p>{h.d}</p></li>)}
        </ol>
      </section>

      <section class="sec" id="team">
        <p class="tag"><i></i>Let&rsquo;s talk</p>
        <h2 class="h2 rv">Book a call with <span class="acc">the people who do the work</span></h2>
        <p class="sub">We are a team of 5 in Warsaw, no account managers in between. In 30 minutes you tell us what you are building, and we tell you what we would change on your website and how we can start. No sales pitch.</p>
        <div class="tmcal" id="home-cal" aria-label="Booking calendar"><p class="tmcal__load mono">Loading calendar</p></div>
      </section>

      <section class="sec" id="faq">
        <p class="tag"><i></i>FAQ</p>
        <h2 class="h2 rv">Questions we get <span class="acc">on calls</span></h2>
        <div class="bd">{home.faq.map(f => <details class="fq"><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
      </section>
    </div>
  </div>
</Base>

<script>import '../scripts/home.js';</script>
<script is:inline>
  /* Cal.com unrootdesign/30min, грузится только когда секция близко */
  (function () {
    var el = document.getElementById('home-cal'); if (!el) return;
    function boot() {
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
      Cal("init", "30min", { origin: "https://cal.com" });
      Cal.ns["30min"]("inline", { elementOrSelector: "#home-cal", config: { layout: "month_view", theme: "light" }, calLink: "unrootdesign/30min" });
      Cal.ns["30min"]("ui", { theme: "light", hideEventTypeDetails: false, layout: "month_view", cssVarsPerTheme: { light: { "cal-brand": "#8961E7" } } });
    }
    if (!('IntersectionObserver' in window)) return boot();
    var io = new IntersectionObserver(function (es) { if (es[0].isIntersecting) { io.disconnect(); boot(); } }, { rootMargin: '800px 0px' });
    io.observe(el);
  })();
</script>
