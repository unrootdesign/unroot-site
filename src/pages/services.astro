---
import ServicePage from '../components/ServicePage.astro';
// title и description дословно из Webflow
const title = "Branding & Design Services for Modern Companies | Unroot Design";
const description = "Build a bold, scalable brand with Unroot.design. We craft modern, timeless identities and websites that help startups and tech companies grow.";
const I = '/images/';
---
<ServicePage title={title} description={description}
  tag="Services"
  h1="Unroot" acc="Services"
  lede="Brand identity, website design, development in Webflow and Framer, 3D and AI visuals. One small team does all of it, so your brand, website and launch visuals look like one company."
  sections={[
    { id: 'branding', tag: 'Service 01', title: 'Full', acc: 'branding', image: { src: I + 'ambient-dreamie-brand-identity.jpg', alt: 'Ambient Dreamie brand identity' }, blocks: [{ kind: 'text', paras: [
      'A complete brand identity, not only a logo: strategy, positioning, tone of voice, visual identity and guidelines. People see the same company on your website, in the product, in decks and on social media, and trust it faster.',
      'We start with your market and competitors and find what makes you different. Then we turn it into a visual system: colors, typography, brand assets and templates your team can use without us.',
    ]}]},
    { id: 'website-design', tag: 'Service 02', title: 'Website', acc: 'design', image: { src: I + 'modern-hero-sections-collage.avif', alt: 'Collage of modern hero sections' }, blocks: [{ kind: 'text', paras: [
      'Websites that look like your brand and do their job: clear navigation, layouts that work on every screen, typography and imagery picked for your product.',
      'We design every page around one question: what does a visitor need to understand before they sign up, book a demo or buy? Then the layout leads them there, section by section.',
    ]}]},
    { id: 'website-development', tag: 'Service 03', title: 'Website', acc: 'development', image: { src: I + 'website-development-services-webflow-framer.avif', alt: 'Website development in Webflow and Framer' }, blocks: [{ kind: 'text', paras: [
      'We build in Webflow and Framer, and write custom code when the project needs it. The result loads fast, stays secure and takes new pages without a rebuild.',
      'Your team edits content in the CMS without calling us. A landing page, a marketing website or a custom web platform: we pick the platform that fits your goals and how you want to maintain the website.',
    ]}]},
    { id: '3d', tag: 'Service 04', title: '3D custom', acc: 'visuals', image: { src: I + '3d-custom-visuals-concepts.avif', alt: '3D custom visuals' }, blocks: [{ kind: 'text', paras: [
      'Product renders, promo visuals and interactive 3D elements. A hero image for your homepage or a key visual for a campaign, made for your brand instead of taken from a stock library.',
    ]}]},
    { id: 'ai', tag: 'Service 05', title: 'AI visuals,', acc: 'concept design', image: { src: I + 'ai-visuals-illustartion.avif', alt: 'AI visuals illustration' }, blocks: [{ kind: 'text', paras: [
      'We use AI to explore concepts, art direction and design variations in hours instead of days. AI speeds up the search, our designers make the decisions.',
    ]}]},
  ]} />
