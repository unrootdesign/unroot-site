---
import ServicePage from '../../components/ServicePage.astro';
// title и description дословно из Webflow
const title = "Webflow & Framer Development for Marketing Sites | Unroot.design";
const description = "We build responsive, production-ready websites in Webflow and Framer — clean structure, scalable CMS, strong performance, and SEO-ready setup.";
const I = '/images/';
---
<ServicePage title={title} description={description} related="web-development"
  tag="Website development"
  h1="Webflow / Framer" acc="Development"
  lede="We build websites in Webflow and Framer that load fast, work on every screen and stay easy to update. We design too, but this page is about the build: turning a design into a live website."
  sections={[
    { tag: 'Approach', title: 'What development means', acc: 'in our studio', image: { src: I + 'logo-unlok-clothing-brand.jpg' }, blocks: [
      { kind: 'text', paras: ['Development is where the website becomes a system: predictable layout rules, reusable components, structured content, and a setup your team can update without breaking the design. We use Webflow and Framer for production websites, with the same rules we would use in code.'] },
      { kind: 'list', items: [
        { t: 'Landing pages and marketing websites', d: 'Launches, product pages, pricing, careers.' },
        { t: 'CMS builds', d: 'Blogs, case studies, resources, changelogs.' },
        { t: 'Rebuilds and platform moves', d: 'Usually together with a redesign, instead of copying the old website as is.' },
      ]},
    ]},
    { tag: 'Platforms', title: 'Webflow vs Framer', acc: 'for real projects', image: { src: I + 'Webflow-vs-Framer-for-real-projects.jpg' }, blocks: [{ kind: 'compare', cols: [
      { t: 'Webflow is a strong choice when you need', items: ['More complex layouts and structure', 'CMS that scales with richer content needs', 'More freedom for custom integrations and advanced setup', 'A mature platform for larger marketing websites'] },
      { t: 'Framer is a strong choice when you need', items: ['A fast, clean marketing website shipped quickly', 'A designer-friendly workflow that stays lightweight', 'Simple CMS and easy iteration', 'A modern look with smooth interactions'] },
    ], note: 'Most marketing websites can be built on either platform. The decision usually comes down to CMS complexity, how you want to maintain the website, and how much long-term flexibility you need.' }]},
    { tag: 'Standards', title: 'Our build', acc: 'standards', image: { src: I + 'Our-build-standards.jpg' }, blocks: [{ kind: 'list', items: [
      { t: 'Responsive behavior that is planned, not patched', d: 'We design breakpoints, spacing and type sizes for each screen, instead of fixing them after launch.' },
      { t: 'Clean structure and reuse', d: 'Webflow class strategy or Framer components that your team can work with.' },
      { t: 'Performance baseline', d: 'Compressed images and light effects, so the website loads fast.' },
      { t: 'SEO and technical hygiene', d: 'Meta fields, clean URLs, heading structure, OG previews, and indexation basics.' },
    ]}]},
    { tag: 'Migration', title: 'Migration', acc: '(when it makes sense)', image: { src: I + 'framer-webflow-interface-compare.jpg' }, blocks: [{ kind: 'text', paras: [
      'If your current platform limits you, we move the website to Webflow or Framer. We do not copy every old detail: we rebuild with a clearer structure and a setup that takes new pages easily.',
    ]}]},
    { tag: 'Kickoff', title: 'What we need', acc: 'to build fast', image: { src: I + 'framer-webflow-interface-compare-2.jpg' }, blocks: [
      { kind: 'list', items: ['Content (or a clear draft)', '2 or 3 reference websites you like', 'Platform decision (or we help you choose)', 'Access to domain and accounts when it is time to launch'] },
      { kind: 'text', paras: ['If you have a Figma file, we can build from that. If you do not, we can define the design direction as part of the process.'] },
    ]},
  ]} />
