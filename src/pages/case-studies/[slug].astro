---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tri from '../../components/Tri.astro';

export async function getStaticPaths() {
  const items = await getCollection('case-studies');
  return items.map((item) => ({ params: { slug: item.data.slug }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
// секция «The project» показывается, только если в кейсе есть текст
const hasBody = !!(item.body && item.body.replace(/<!--[\s\S]*?-->/g, '').trim());
const others = (await getCollection('case-studies'))
  .filter(i => i.data.slug !== d.slug)
  .sort((a, b) => a.data.order - b.data.order);
const host = d.liveUrl ? d.liveUrl.replace(/^https?:\/\//, '').replace(/\/$/, '') : '';
const label = (t: string) => t.replace(/-/g, ' ');
// превью в «Other projects»: те же кадры 16:9, что на главной, чтобы ничего не обрезалось
const THUMB: Record<string, string> = { dreamie: '/home/w-dreamie-1.jpg', switch: '/home/w-switch-1.jpg', javelinvp: '/home/w-javelin-1.jpg', trustyfy: '/home/w-trustyfy-1.jpg', 'epsilon-health': '/home/w-epsilon-1.jpg' };
---
<Base title={d.seoTitle} description={d.seoDescription} ogImage={d.ogImage} noindex={d.noindex}
  schema={[{
    '@context': 'https://schema.org', '@type': 'CreativeWork',
    name: d.title, about: d.client, creator: { '@type': 'Organization', name: 'Unroot Design' },
  }]}>

  <!-- кейс в 2 колонки: слева название и кнопка сайта, справа описание, факты, картинки и отзыв в одной ширине -->
  <header class="phead">
    <div class="wrap cs__grid">
      <div>
        <nav class="crumbs mono" aria-label="Breadcrumb"><a href="/#work">Work</a><span aria-hidden="true">/</span><span>Case study</span></nav>
        <h1 class="h1 cs__h">{d.title}</h1>
        {d.liveUrl && <a class="btn btn--line cs__visit" href={d.liveUrl} target="_blank" rel="noopener"><span>Visit the website</span><Tri /></a>}
      </div>
      <div class="cs__r">
        {d.cardDescription && <p class="lede cs__lede">{d.cardDescription}</p>}
        <ul class="facts-list mono">
          <li><span>Client</span><span>{d.client}</span></li>
          {d.year && <li><span>Year</span><span>{d.year}</span></li>}
          {d.tags.length > 0 && <li><span>Scope</span><span>{d.tags.map(label).join(', ')}</span></li>}
        </ul>
      </div>
    </div>
  </header>

  {(d.video || d.gallery.length > 0) && (
    <section class="sec cs__media">
      <div class="wrap cs__grid">
        <div></div>
        <div class="cs__r cs__stack">
          {d.video && <video class="cs__img" src={d.video} muted loop playsinline autoplay preload="metadata"></video>}
          {d.gallery.map(g => <img class="cs__img" src={g.src} alt={g.alt} loading="lazy" decoding="async" />)}
        </div>
      </div>
    </section>
  )}

  {hasBody && (
    <section class="sec sec--white">
      <div class="wrap cs__grid">
        <div><p class="tag"><i></i>The project</p></div>
        <div class="prose cs__r"><Content /></div>
      </div>
    </section>
  )}

  {d.testimonial && (
    <section class="sec">
      <div class="wrap cs__grid">
        <div><p class="tag"><i></i>Client</p></div>
        <blockquote class="quote cs__r">
          <p>&ldquo;{d.testimonial.quote}&rdquo;</p>
          <footer>
            {d.testimonial.photo && <img src={d.testimonial.photo} alt={d.testimonial.name} loading="lazy" />}
            <span><b>{d.testimonial.name}</b><s>{d.testimonial.role}</s></span>
          </footer>
        </blockquote>
      </div>
    </section>
  )}

  <section class="sec">
    <div class="wrap">
      <p class="tag"><i></i>More work</p>
      <h2 class="h2">Other <span class="acc">projects</span></h2>
      <ul class="cards cs__more" id="csMore">
        {others.map(o => (
          <li class="card"><a href={`/case-studies/${o.data.slug}`}>
            {(THUMB[o.data.slug] || o.data.cover || o.data.gallery[0]) && <img class="card__img cs__thumb" src={THUMB[o.data.slug] ?? o.data.cover ?? o.data.gallery[0].src} alt={o.data.coverAlt || o.data.title} loading="lazy" decoding="async" />}
            <p class="card__k mono">{o.data.tags.slice(0, 2).map(label).join(' · ')}</p>
            <h3 class="card__t">{o.data.title}</h3>
            <p class="card__d">{o.data.cardDescription}</p>
            <span class="card__go link">View case <Tri /></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .cs__host { color: var(--violet-d); }
  .cs__host:hover { color: var(--ink); }
  /* правая колонка одной ширины для текста и картинок; картинки в своих пропорциях */
  .cs__r { width: 100%; max-width: 44rem; justify-self: end; }
  .cs__media { border-top: 0; padding-top: 0; }
  /* первый заголовок текста встаёт на одну линию с меткой слева */
  .cs__grid > .prose > :global(:first-child) { margin-top: 0; }
  .cs__grid > div > .tag { margin-top: 0; }
  .cs__h { font-size: clamp(2.4rem, 4vw, 3.4rem); }
  .cs__visit { margin-top: 28px; }
  .cs__lede { margin-top: 0; margin-bottom: 28px; max-width: none; }
  .cs__stack { display: grid; gap: clamp(20px, 3vw, 32px); align-content: start; }
  .cs__img { width: 100%; height: auto; display: block; border: 1px solid var(--line); background: #fff; }
  .cs__grid { display: grid; grid-template-columns: minmax(180px, 260px) minmax(0, 1fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
  @media (max-width: 960px) { .cs__grid { grid-template-columns: 1fr; } }
  .cs__more { margin-top: clamp(32px, 4vw, 48px); }
  .cs__thumb { aspect-ratio: 16/9; }
  /* показываем 3 других проекта; какие именно, выбирается случайно при загрузке */
  .cs__more > li:nth-child(n+4) { display: none; }
</style>

<script>
  // перемешиваем другие проекты, видны первые 3
  const ul = document.getElementById('csMore');
  if (ul) [...ul.children].sort(() => Math.random() - .5).forEach(li => ul.appendChild(li));
</script>
