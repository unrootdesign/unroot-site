---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tri from '../components/Tri.astro';
const CAT: Record<string,string> = { 'web-design': 'Web design', 'web-development': 'Web development', 'logo-design': 'Logo design' };

const posts = (await getCollection('blog'))
  .filter(p => !p.data.noindex)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const title = "Blog — Insights & Ideas for Modern Branding and Logo Design | Unroot Design";
const description = "Explore Unroot Blog for expert insights on modern branding, logo design, and creative strategy. Discover guides, tips, and stories to elevate your brand identity.";
---

<Base title={title} description={description} ogImage="/images/Blog-OG.jpg">
  <header class="phead">
    <div class="wrap">
      <p class="tag"><i></i>Blog</p>
      <h1 class="h1">Blog</h1>
      <p class="lede">Guides on website design, Webflow and Framer, logos and branding.</p>
      <ul class="cards blog__grid">
        {posts.map(p => (
          <li class="card"><a href={`/${p.data.category}/${p.data.slug}`}>
            {p.data.cover && <img class="card__img" src={p.data.cover} alt={p.data.coverAlt} loading="lazy" decoding="async" />}
            <p class="card__k mono">{CAT[p.data.category]}</p>
            <h2 class="card__t">{p.data.title}</h2>
            {p.data.excerpt && <p class="card__d">{p.data.excerpt}</p>}
            <span class="card__go link">Read <Tri /></span>
          </a></li>
        ))}
      </ul>
    </div>
  </header>
</Base>

<style>
  .blog__grid { margin-top: clamp(40px, 5vw, 64px); }
</style>
