---
import Base from '../layouts/Base.astro';
import Tri from '../components/Tri.astro';
import { BUY_CONCEPT } from '../data/links';

// title дословно из Webflow, description в Webflow не было
const title = "Book a Call | Unroot Design";
const description = "Book a 30 minute call with Unroot Design to talk about your website, brand or product design project.";
const VIDEO = 'https://cdn.prod.website-files.com/63b1a61bccd2eafa936ec2d8/69eb635eec55b0b94490f70c_11440b15bb7bcf08d33c7cfd0084cb56_playlist.txt';
---
<Base title={title} description={description}>
  <header class="phead call">
    <div class="wrap call__grid">
      <div>
        <p class="tag"><i></i>Book a call</p>
        <h1 class="h1">Let&rsquo;s talk about <span class="acc">your project</span></h1>
        <p class="lede">Pick a time for a 30 minute call. Tell us what you are building and where the website should go next.</p>
        <div class="win frame call__video">
          <span class="win__bar"><i></i><i></i><i></i></span>
          <div class="call__stage">
            <video id="callVideo" playsinline loop preload="none" poster="/images/call-poster.webp" data-src={VIDEO}></video>
            <button class="call__play" id="callPlay" type="button" aria-label="Play video"><svg viewBox="0 0 99 114" aria-hidden="true"><path d="M98.25 56.72L0 113.45V0z" fill="currentColor"/></svg></button>
          </div>
        </div>
        <p class="call__alt mono">Not ready for a call? <a href={BUY_CONCEPT}>Get a concept first <Tri /></a></p>
      </div>
      <div class="call__cal" id="my-cal-inline" aria-label="Booking calendar"></div>
    </div>
  </header>
</Base>

<style>
  .call__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  @media (max-width: 1000px) { .call__grid { grid-template-columns: 1fr; } }
  .call__video { margin-top: 36px; }
  .call__stage { position: relative; aspect-ratio: 16/9; background: var(--night); }
  .call__stage video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .call__play { position: absolute; inset: 0; display: grid; place-items: center; border: 0; background: rgba(29,19,54,.35); color: #fff; cursor: pointer; transition: opacity var(--t) var(--ease); }
  .call__play svg { width: 44px; height: 44px; padding: 16px 14px 16px 18px; box-sizing: content-box; background: var(--violet); }
  .call__play:hover svg { background: var(--violet-hi); }
  .call__play.off { opacity: 0; }
  .call__alt { margin-top: 26px; color: var(--ink-3); display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .call__alt a { display: inline-flex; align-items: center; gap: 8px; color: var(--violet-d); }
  .call__alt a:hover { color: var(--ink); }
  .call__cal { min-height: 640px; border: 1px solid var(--line); background: var(--white); overflow: auto; }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/hls.js@1.5.13/dist/hls.min.js"></script>
<script is:inline>
  (function () {
    var v = document.getElementById('callVideo'), btn = document.getElementById('callPlay');
    if (!v) return;
    var url = v.dataset.src, ready = false;
    function load() {
      if (ready) return; ready = true;
      if (window.Hls && Hls.isSupported()) { var h = new Hls(); h.loadSource(url); h.attachMedia(v); }
      else if (v.canPlayType('application/vnd.apple.mpegurl')) { v.src = url; }
    }
    btn.addEventListener('click', function () {
      load();
      if (v.paused) { v.play().catch(function(){}); btn.classList.add('off'); } else { v.pause(); btn.classList.remove('off'); }
    });
    v.addEventListener('click', function () { if (!v.paused) { v.pause(); btn.classList.remove('off'); } });
  })();

  /* Cal.com, как на текущем сайте: unrootdesign/30min */
  (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
  Cal("init", "30min", { origin: "https://cal.com" });
  Cal.ns["30min"]("inline", { elementOrSelector: "#my-cal-inline", config: { layout: "month_view", theme: "light" }, calLink: "unrootdesign/30min" });
  Cal.ns["30min"]("ui", { theme: "light", hideEventTypeDetails: false, layout: "month_view", cssVarsPerTheme: { light: { "cal-brand": "#8961E7" } } });
</script>
