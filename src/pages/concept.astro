---
import LandingPage from '../components/LandingPage.astro';
import { BUY_CONCEPT } from '../data/links';
import { home } from '../data/home';
// текст из документа Adam «Batch 1: page copy and build notes», Page 3. Старые ссылки /concept из био ведут сюда
const title = "Homepage redesign in 7 days, $1,499 | Unroot Design";
const description = "Send us a link. In 7 days you get a clickable animated homepage for $1,499, credited to the full website within 60 days.";
---
<LandingPage title={title} description={description}
  tag="Concept"
  crumbs={[{ name: 'Home', href: '/' }, { name: 'Concept' }]}
  h1="Your new homepage in 7 days"
  lede="Send us a link. In 7 days you get a clickable, animated version of your new homepage. $1,499, and it goes toward the full website if you start within 60 days."
  sections={[
    { h: 'What you get', blocks: [{ kind: 'bullets', items: [
      'An animated homepage concept: hero plus 3 sections.',
      'Designed in Figma and turned into a live preview you can click through and share with your team.',
      'Our direction for where your redesign should go.',
      'The files are yours to keep and build on.',
    ]}]},
    { h: 'How it works', blocks: [{ kind: 'steps', items: [
      { d: 'Send a link to your current website and any context you have. We read all of it. We do not ask for moodboards or brand kits: choosing the direction is our job.' },
      { d: 'Pay $1,499 securely.' },
      { d: 'In 7 days you get the live preview.' },
    ]}]},
    { h: 'Before and after', blocks: [
      { kind: 'text', html: ['Each pair shows a homepage before and 7 days later: Chatarmin, Javelin VP, Switch, Epsilon Health, Ambient Dreamie, ResumAI and Leadgains.'] },
      { kind: 'pairs', items: home.ba },
    ]},
    { h: 'Not included', blocks: [{ kind: 'text', html: [
      'Revisions. The concept is 1 direction, done once. Revisions happen in the full project, which is priced separately.',
    ]}]},
    { h: 'If you do not move forward', blocks: [{ kind: 'text', html: ['You keep the concept and can build it with anyone.'] }]},
    { h: 'If you do', blocks: [{ kind: 'text', html: [
      'The $1,499 goes toward the full website if you start within 60 days. See the <a href="/pricing">pricing page</a>.',
    ]}]},
  ]}
  faqTitle="Questions"
  faq={[
    { q: 'What exactly do I get for $1,499?', a: 'An animated homepage concept, hero plus 3 sections. Designed in Figma and turned into a live preview you can click through, with our take on where your redesign should go. Delivered in 7 days.' },
    { q: 'Are revisions included?', a: 'No. The concept is 1 direction, done once.' },
    { q: 'Can I give input before you start?', a: 'Send any context you have, we read all of it.' },
    { q: 'What if I do not move forward?', a: 'You keep the concept and can build it with anyone.' },
  ]}
  closing="Take the concept, or want a call first?"
  extraSchema={[{
    '@context': 'https://schema.org', '@type': 'Offer', name: 'Homepage concept', description,
    price: '1499', priceCurrency: 'USD', url: BUY_CONCEPT,
    seller: { '@type': 'Organization', name: 'Unroot Design', url: 'https://unroot.design' },
  }]}
/>
