---
interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description = '', image = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {image && <meta property="og:image" content={image} />}
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #111; background: #f5f5f2; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; }
  a { color: inherit; }
  .container { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
  .site-header { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid #cfcfc8; background: rgba(245,245,242,.94); backdrop-filter: blur(10px); }
  .nav { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { font-weight: 800; text-decoration: none; letter-spacing: -.04em; font-size: 22px; }
  .nav-links { display: flex; flex-wrap: wrap; gap: 14px 20px; font-size: 13px; }
  .nav-links a { text-decoration: none; opacity: .72; }
  .nav-links a:hover { opacity: 1; }
  .hero { padding: 96px 0 64px; border-bottom: 1px solid #cfcfc8; }
  .eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: 12px; opacity: .55; margin: 0 0 18px; }
  h1 { max-width: 920px; font-size: clamp(44px, 7vw, 96px); line-height: .95; letter-spacing: -.065em; margin: 0; }
  .intro { max-width: 720px; margin: 32px 0 0; font-size: clamp(18px, 2vw, 24px); line-height: 1.45; color: #4c4c48; }
  .meta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 34px; }
  .pill { border: 1px solid #bdbdb6; border-radius: 999px; padding: 8px 12px; font-size: 12px; background: #fff; }
  .sections { padding: 28px 0 96px; }
  .section-card { min-height: 220px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 32px; padding: 32px 0; border-bottom: 1px solid #cfcfc8; }
  .section-index { font-size: 12px; opacity: .5; }
  .section-card h2 { font-size: clamp(28px, 4vw, 56px); line-height: 1; letter-spacing: -.045em; margin: 0 0 16px; }
  .placeholder { border: 1px dashed #aaa; min-height: 96px; padding: 18px; background: rgba(255,255,255,.5); color: #777; font-size: 13px; display: flex; align-items: center; }
  footer { border-top: 1px solid #cfcfc8; padding: 34px 0 60px; font-size: 13px; color: #666; }
  @media (max-width: 760px) {
    .nav { align-items: flex-start; padding: 16px 0; }
    .nav-links { max-width: 75%; justify-content: flex-end; }
    .hero { padding-top: 64px; }
    .section-card { grid-template-columns: 1fr; min-height: 0; }
  }
</style>
